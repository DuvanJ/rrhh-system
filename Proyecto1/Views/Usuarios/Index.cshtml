@model IEnumerable<Proyecto1.Models.UsuarioListado>


@{
    ViewData["Title"] = "Usuarios";
}

<h2>Usuarios del Sistema</h2>

<a asp-action="Create" class="btn btn-success mb-3">Nuevo Usuario</a>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text"
               name="buscar"
               value="@ViewBag.Buscar"
               class="form-control"
               placeholder="Buscar por nombre de usuario" />
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">
            Buscar
        </button>
    </div>

    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-secondary">
            Limpiar
        </a>
    </div>
</form>



<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Usuario</th>
            <th>Correo</th>
            <th>Perfil</th>
            <th>Estado</th>
            <th style="width:180px">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.NombreUsuario</td>
                <td>@u.Correo</td>
                <td>@u.NombrePerfil</td>
                <td>
                    @if (u.Estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@u.IdUsuario"
                       class="btn btn-warning btn-sm">Editar</a>

                    <a asp-action="CambiarEstado" asp-route-id="@u.IdUsuario"
                       class="btn btn-secondary btn-sm">
                        Cambiar estado
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        const sinResultados = @((ViewBag.SinResultados ?? false).ToString().ToLower());

        if (sinResultados) {
            Swal.fire({
                icon: 'info',
                title: 'Sin resultados',
                text: 'No se encontraron usuarios con ese criterio.',
                confirmButtonText: 'OK'
            });
        }
    </script>
}

