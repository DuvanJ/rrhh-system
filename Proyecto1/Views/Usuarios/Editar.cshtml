@model Proyecto1.Models.Usuario

<h2>Editar Usuario</h2>

<form method="post">

    <input type="hidden" name="IdUsuario" value="@Model.IdUsuario" />

    <label>Usuario</label>
    <input class="form-control" name="NombreUsuario" value="@Model.NombreUsuario" required />

    <label>Correo</label>
    <input class="form-control" name="Correo" value="@Model.Correo" required />

    <label>Perfil</label>
    <select class="form-control" name="IdPerfil">
        <option value="1" selected="@(Model.IdPerfil == 1)">Administrador</option>
        <option value="2" selected="@(Model.IdPerfil == 2)">RRHH</option>
        <option value="3" selected="@(Model.IdPerfil == 3)">Colaborador</option>
    </select>

    <label>Estado</label>
    <select class="form-control" name="Estado">
        <option value="true" selected="@(Model.Estado)">Activo</option>
        <option value="false" selected="@(!Model.Estado)">Inactivo</option>
    </select>

    <button class="btn btn-primary mt-3">Actualizar</button>
</form>
