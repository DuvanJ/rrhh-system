@model Proyecto1.Models.Usuario

<h2>Crear Usuario</h2>

<form method="post">

    <label>Usuario</label>
    <input class="form-control" name="NombreUsuario" required />

    <label>Correo</label>
    <input class="form-control" name="Correo" required />

    <label>Contraseña</label>
    <input class="form-control" name="ContrasenaHash" type="password" required />

    <label>Perfil</label>
    <select class="form-control" name="IdPerfil" required>
        <option value="1">Administrador</option>
        <option value="2">RRHH</option>
        <option value="3">Colaborador</option>
    </select>

    <button class="btn btn-primary mt-3">Guardar</button>
</form>
