@{
    ViewData["Title"] = "Recuperar Contrasena";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RRHH System</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">

    <div class="login-page">

        @* ---- PANEL IZQUIERDO ---- *@
        <div class="login-left">
            <div class="login-left-content">
                <div class="login-brand-icon">
                    <i class="bi bi-buildings-fill"></i>
                </div>
                <h2 class="login-brand-title">RRHH System</h2>
                <p class="login-brand-sub">
                    Plataforma integral de gestion de recursos humanos.
                    Planillas, colaboradores, vacaciones y mucho mas.
                </p>
                <div class="login-features">
                    <div class="login-feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Gestion de planillas y pagos</span>
                    </div>
                    <div class="login-feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Control de asistencia y permisos</span>
                    </div>
                    <div class="login-feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Reportes y consultas en tiempo real</span>
                    </div>
                    <div class="login-feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Acceso por roles y perfiles</span>
                    </div>
                </div>
            </div>
        </div>

        @* ---- PANEL DERECHO ---- *@
        <div class="login-right">

            <div class="login-card">

                @* Brand mobile *@
                <div class="login-mobile-brand d-lg-none">
                    <i class="bi bi-buildings-fill"></i>
                    <span>RRHH System</span>
                </div>

                @* Header con icono *@
                <div class="login-card-header">
                    <div class="login-step-icon amber">
                        <i class="bi bi-key-fill"></i>
                    </div>
                    <h4 class="login-card-title">Recuperar contrasena</h4>
                    <p class="login-card-sub">
                        Ingresa tu correo registrado y te enviaremos un enlace para restablecer tu contrasena.
                    </p>
                </div>

                @* Alertas *@
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                @if (ViewBag.Mensaje != null)
                {
                    <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                        <span>@ViewBag.Mensaje</span>
                    </div>
                }

                <form asp-controller="Login" asp-action="RecuperarContrasena" method="post">

                    <div class="mb-4">
                        <label class="form-label">Correo electronico</label>
                        <div class="login-input-group">
                            <i class="bi bi-envelope-fill login-input-icon"></i>
                            <input type="email"
                                   name="correo"
                                   class="form-control login-input"
                                   placeholder="correo@empresa.com"
                                   autocomplete="email"
                                   required />
                        </div>
                    </div>

                    <button type="submit" class="btn-login w-100 mb-4">
                        <i class="bi bi-send me-2"></i>Enviar enlace de recuperacion
                    </button>

                    <div class="text-center">
                        <a href="@Url.Action("Index", "Login")" class="login-forgot-link">
                            <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesion
                        </a>
                    </div>

                </form>

            </div>

            <footer class="login-footer">
                © @DateTime.Now.Year RRHH System · Todos los derechos reservados
            </footer>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>