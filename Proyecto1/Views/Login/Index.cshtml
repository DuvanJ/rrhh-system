@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RRHH System</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">

    <div class="login-page">

        @* ---- PANEL IZQUIERDO ---- *@
        <div class="login-left">
            <div class="login-left-content">
                <div class="login-brand-icon">
                    <i class="bi bi-buildings-fill"></i>
                </div>
                <h2 class="login-brand-title">RRHH System</h2>
                <p class="login-brand-sub">
                    Plataforma integral de gestión de recursos humanos.
                    Planillas, colaboradores, vacaciones y mucho más.
                </p>
                <div class="login-features">
                    <div class="login-feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Gestión de planillas y pagos</span>
                    </div>
                    <div class="login-feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Control de asistencia y permisos</span>
                    </div>
                    <div class="login-feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Reportes y consultas en tiempo real</span>
                    </div>
                    <div class="login-feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Acceso por roles y perfiles</span>
                    </div>
                </div>
            </div>
        </div>

        @* ---- PANEL DERECHO ---- *@
        <div class="login-right">

            <div class="login-card">

                @* Brand mobile *@
                <div class="login-mobile-brand d-lg-none">
                    <i class="bi bi-buildings-fill"></i>
                    <span>RRHH System</span>
                </div>

                <div class="login-card-header">
                    <h4 class="login-card-title">Bienvenido</h4>
                    <p class="login-card-sub">Ingresa tus credenciales para continuar</p>
                </div>

                @* ---- ALERTAS ---- *@
                @{
                    var error = TempData["Error"]?.ToString() ?? ViewBag.Error as string;
                    var mensaje = TempData["Mensaje"]?.ToString() ?? ViewBag.Mensaje as string;
                }

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
                        <span>@error</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(mensaje))
                {
                    <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                        <span>@mensaje</span>
                    </div>
                }

                <form method="post">

                    @* Usuario *@
                    <div class="mb-4">
                        <label class="form-label">Usuario</label>
                        <div class="login-input-group">
                            <i class="bi bi-person-fill login-input-icon"></i>
                            <input type="text"
                                   class="form-control login-input @(!string.IsNullOrEmpty(error) ? "is-invalid-login" : "")"
                                   name="usuario"
                                   placeholder="Ingrese su usuario"
                                   autocomplete="username"
                                   required />
                        </div>
                    </div>

                    @* Contraseña *@
                    <div class="mb-4">
                        <label class="form-label">Contraseña</label>
                        <div class="login-input-group">
                            <i class="bi bi-lock-fill login-input-icon"></i>
                            <input type="password"
                                   id="inputPassword"
                                   class="form-control login-input @(!string.IsNullOrEmpty(error) ? "is-invalid-login" : "")"
                                   name="contrasena"
                                   placeholder="Ingrese su contraseña"
                                   autocomplete="current-password"
                                   required />
                            <button type="button"
                                    class="login-input-toggle"
                                    onclick="togglePassword()"
                                    tabindex="-1">
                                <i id="iconPassword" class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    @* Botón *@
                    <button type="submit" class="btn-login w-100 mb-4">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Ingresar
                    </button>

                    @* Recuperar *@
                    <div class="text-center">
                        <a href="@Url.Action("RecuperarContrasena", "Login")" class="login-forgot-link">
                            <i class="bi bi-key me-1"></i>¿Olvidó su contraseña?
                        </a>
                    </div>

                </form>

            </div>

            <footer class="login-footer">
                © @DateTime.Now.Year RRHH System · Todos los derechos reservados
            </footer>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword() {
            const input = document.getElementById('inputPassword');
            const icon  = document.getElementById('iconPassword');
            if (input.type === 'password') {
                input.type     = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type     = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>

</body>
</html>