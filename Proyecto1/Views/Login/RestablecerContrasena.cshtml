@{
    ViewData["Title"] = "Restablecer Contrasena";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RRHH System</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">

    <div class="login-page">

        @* ---- PANEL IZQUIERDO ---- *@
        <div class="login-left">
            <div class="login-left-content">
                <div class="login-brand-icon">
                    <i class="bi bi-buildings-fill"></i>
                </div>
                <h2 class="login-brand-title">RRHH System</h2>
                <p class="login-brand-sub">
                    Plataforma integral de gestion de recursos humanos.
                    Planillas, colaboradores, vacaciones y mucho mas.
                </p>
                <div class="login-features">
                    <div class="login-feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Gestion de planillas y pagos</span>
                    </div>
                    <div class="login-feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Control de asistencia y permisos</span>
                    </div>
                    <div class="login-feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Reportes y consultas en tiempo real</span>
                    </div>
                    <div class="login-feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Acceso por roles y perfiles</span>
                    </div>
                </div>
            </div>
        </div>

        @* ---- PANEL DERECHO ---- *@
        <div class="login-right">

            <div class="login-card">

                @* Brand mobile *@
                <div class="login-mobile-brand d-lg-none">
                    <i class="bi bi-buildings-fill"></i>
                    <span>RRHH System</span>
                </div>

                @* Header con icono *@
                <div class="login-card-header">
                    <div class="login-step-icon green">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h4 class="login-card-title">Nueva contrasena</h4>
                    <p class="login-card-sub">
                        Elige una contrasena segura. Debe tener al menos 8 caracteres.
                    </p>
                </div>

                @* Alertas *@
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form asp-controller="Login" asp-action="RestablecerContrasena" method="post">

                    <input type="hidden" name="token" value="@ViewBag.Token" />

                    @* Nueva contrasena *@
                    <div class="mb-4">
                        <label class="form-label">Nueva contrasena</label>
                        <div class="login-input-group">
                            <i class="bi bi-lock-fill login-input-icon"></i>
                            <input type="password"
                                   id="inputPassword"
                                   name="password"
                                   class="form-control login-input"
                                   placeholder="Minimo 8 caracteres"
                                   minlength="8"
                                   autocomplete="new-password"
                                   required />
                            <button type="button"
                                    class="login-input-toggle"
                                    onclick="toggle('inputPassword', 'iconPass1')"
                                    tabindex="-1">
                                <i id="iconPass1" class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    @* Confirmar contrasena *@
                    <div class="mb-4">
                        <label class="form-label">Confirmar contrasena</label>
                        <div class="login-input-group">
                            <i class="bi bi-lock-fill login-input-icon"></i>
                            <input type="password"
                                   id="inputConfirmar"
                                   name="confirmar"
                                   class="form-control login-input"
                                   placeholder="Repite la contrasena"
                                   minlength="8"
                                   autocomplete="new-password"
                                   required />
                            <button type="button"
                                    class="login-input-toggle"
                                    onclick="toggle('inputConfirmar', 'iconPass2')"
                                    tabindex="-1">
                                <i id="iconPass2" class="bi bi-eye"></i>
                            </button>
                        </div>
                        @* Indicador de coincidencia *@
                        <p id="matchMsg" class="form-text mt-2" style="display:none;"></p>
                    </div>

                    <button type="submit" id="btnSubmit" class="btn-login w-100 mb-4">
                        <i class="bi bi-check-circle me-2"></i>Cambiar contrasena
                    </button>

                    <div class="text-center">
                        <a href="@Url.Action("Index", "Login")" class="login-forgot-link">
                            <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesion
                        </a>
                    </div>

                </form>

            </div>

            <footer class="login-footer">
                © @DateTime.Now.Year RRHH System · Todos los derechos reservados
            </footer>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggle(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon  = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type     = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type     = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        // Validacion en tiempo real de coincidencia
        const pass     = document.getElementById('inputPassword');
        const confirm  = document.getElementById('inputConfirmar');
        const matchMsg = document.getElementById('matchMsg');
        const btnSubmit = document.getElementById('btnSubmit');

        function validarCoincidencia() {
            if (confirm.value.length === 0) {
                matchMsg.style.display = 'none';
                return;
            }
            matchMsg.style.display = 'block';
            if (pass.value === confirm.value) {
                matchMsg.textContent  = 'Las contrasenas coinciden';
                matchMsg.style.color  = 'var(--green)';
                confirm.style.borderColor = 'var(--green)';
                btnSubmit.disabled    = false;
            } else {
                matchMsg.textContent  = 'Las contrasenas no coinciden';
                matchMsg.style.color  = 'var(--red)';
                confirm.style.borderColor = 'var(--red)';
                btnSubmit.disabled    = true;
            }
        }

        confirm.addEventListener('input', validarCoincidencia);
        pass.addEventListener('input', validarCoincidencia);
    </script>

</body>
</html>