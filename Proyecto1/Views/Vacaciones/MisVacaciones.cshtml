@model IEnumerable<Proyecto1.Models.VacacionColabVM>

@{
    ViewData["Title"] = "Mis Vacaciones";
    var lista = Model.ToList();
    var pendientes = lista.Count(v => v.Estado == "Pendiente");
    var aprobadas = lista.Count(v => v.Estado == "Aprobada");
    var rechazadas = lista.Count(v => v.Estado == "Rechazada");
    var totalDias = lista.Where(v => v.Estado == "Aprobada")
                         .Sum(v => v.DiasSolicitados);
}

@* ================================================
   HEADER
   ================================================ *@
<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-sun"></i>Mis Vacaciones
    </h3>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-house"></i>Inicio
    </a>
</div>

@* ================================================
   KPI CARDS
   ================================================ *@
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total solicitudes</div>
                <div class="kpi-value">@lista.Count</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-sun"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Pendientes</div>
                <div class="kpi-value" style="color:var(--amber)">@pendientes</div>
            </div>
            <div class="kpi-icon amber">
                <i class="bi bi-clock-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Aprobadas</div>
                <div class="kpi-value" style="color:var(--green)">@aprobadas</div>
            </div>
            <div class="kpi-icon green">
                <i class="bi bi-check-circle-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Días aprobados</div>
                <div class="kpi-value" style="color:var(--green)">@totalDias</div>
            </div>
            <div class="kpi-icon green">
                <i class="bi bi-calendar-check"></i>
            </div>
        </div>
    </div>

</div>

@* ================================================
   BOTÓN SOLICITAR
   ================================================ *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted" style="font-size:0.82rem;">
        @lista.Count solicitud(es) registrada(s)
    </span>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i>Solicitar vacaciones
    </a>
</div>

@* ================================================
   TABLA
   ================================================ *@
<div class="card">
    <div class="card-header">
        <span class="card-header-title">
            <i class="bi bi-table"></i>Historial de solicitudes
        </span>
        <div class="d-flex align-items-center gap-3">
            <select id="filtroEstado"
                    class="form-select form-select-sm"
                    style="width:140px;">
                <option value="">Todas</option>
                <option value="Pendiente">Pendientes</option>
                <option value="Aprobada">Aprobadas</option>
                <option value="Rechazada">Rechazadas</option>
            </select>
            <span class="badge badge-info" id="badgeContador">
                @lista.Count registros
            </span>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaVacaciones" class="tabla-sistema w-100">
                <thead>
                    <tr>
                        <th class="text-center">Inicio</th>
                        <th class="text-center">Fin</th>
                        <th class="text-center">Días</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lista.Any())
                    {
                        foreach (var v in lista.OrderByDescending(v => v.FechaInicio))
                        {
                            string badgeClass = v.Estado switch
                            {
                                "Aprobada" => "bg-success",
                                "Pendiente" => "bg-warning",
                                _ => "bg-danger"
                            };

                            var esPendiente = v.Estado == "Pendiente";

                            <tr data-estado="@v.Estado"
                                class="@(esPendiente ? "fila-pendiente" : "")">
                                <td class="text-center td-mono">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        @if (esPendiente)
                                        {
                                            <span class="badge bg-warning"
                                                  style="font-size:0.65rem;">PENDIENTE</span>
                                        }
                                        @v.FechaInicio.ToString("dd/MM/yyyy")
                                    </div>
                                </td>
                                <td class="text-center td-mono">
                                    @v.FechaFin.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center">
                                    <span class="td-mono"
                                          style="font-weight:700;color:var(--blue)">
                                        @v.DiasSolicitados
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @badgeClass badge-dot">
                                        @v.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="table-empty">
                                    <i class="bi bi-sun"></i>
                                    <p>No tienes solicitudes de vacaciones registradas</p>
                                    <a asp-action="Create" class="btn btn-success btn-sm">
                                        <i class="bi bi-plus-circle"></i>Solicitar vacaciones
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .fila-pendiente {
            background: #fffbeb !important;
        }

            .fila-pendiente:hover {
                background: #fef3c7 !important;
            }
    </style>
}

@section Scripts {
    <script>

        $(document).ready(function () {
            if (@lista.Any().ToString().ToLower()) {
                var config = Object.assign({}, DataTableConfig, {
                    order: [[0, 'desc']]
                });
                $('#tablaVacaciones').DataTable(config);
            }
        });

        var filtroEstado  = document.getElementById('filtroEstado');
        var badgeContador = document.getElementById('badgeContador');

        filtroEstado.addEventListener('change', function () {
            var estado = this.value;
            var table  = $('#tablaVacaciones').DataTable();

            table.rows().every(function () {
                var fila       = this.node();
                var filaEstado = fila.getAttribute('data-estado');
                var ok         = estado === '' || filaEstado === estado;
                $(fila).toggle(ok);
            });

            var visibles = $('#tablaVacaciones tbody tr:visible').length;
            badgeContador.textContent = visibles + ' registros';
        });

    </script>
}