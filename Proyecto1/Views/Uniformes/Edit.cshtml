@model Proyecto1.Models.EntregaUniformeVM

@{
    ViewData["Title"] = "Editar Entrega de Uniforme";

    var iniciales = Model.NombreColaborador?
        .Split(' ')
        .Where(s => !string.IsNullOrEmpty(s))
        .Take(2)
        .Select(s => s[0].ToString())
        .Aggregate("", (acc, c) => acc + c)
        .ToUpper() ?? "??";
}

@* ================================================
   HEADER
   ================================================ *@
<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-bag-check"></i>Editar Entrega de Uniforme
    </h3>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>Volver
    </a>
</div>

<form asp-action="Edit" method="post" id="formEditar" novalidate>

    @* Hiddens necesarios para el POST *@
    <input type="hidden" asp-for="IdColaborador" />
    <input type="hidden" asp-for="NombreColaborador" />

    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-12">

            @* Tarjeta de identidad *@
            <div class="card mb-3">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar-circle avatar-blue"
                             style="width:48px;height:48px;font-size:1rem;flex-shrink:0;">
                            @iniciales
                        </div>
                        <div>
                            <div style="font-size:1rem;font-weight:700;color:var(--navy);">
                                @Model.NombreColaborador
                            </div>
                            <div style="font-size:0.82rem;color:var(--text-3);">
                                ID Colaborador: @Model.IdColaborador
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* ================================================
               DATOS GENERALES
               ================================================ *@
            <div class="card mb-4">
                <div class="card-header">
                    <span class="card-header-title">
                        <i class="bi bi-calendar-event"></i>Datos de la entrega
                    </span>
                </div>
                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">ID Colaborador</label>
                            <input class="form-control"
                                   value="@Model.IdColaborador"
                                   readonly
                                   style="background:var(--slate-ll);cursor:not-allowed;" />
                            <span class="form-text">El colaborador no puede modificarse</span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Fecha de entrega <span class="required">*</span>
                            </label>
                            <input asp-for="FechaEntrega"
                                   type="date"
                                   class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <textarea asp-for="Observaciones"
                                      id="inputObservaciones"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Observaciones generales..."
                                      style="resize:vertical;"></textarea>
                            <div class="d-flex justify-content-end mt-1">
                                <span id="contadorObs" class="form-text">
                                    @(Model.Observaciones?.Length ?? 0) / 300
                                </span>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            @* ================================================
               UNIFORMES
               ================================================ *@
            <div class="card mb-4">
                <div class="card-header">
                    <span class="card-header-title">
                        <i class="bi bi-bag-check"></i>Uniformes entregados
                    </span>
                    <span class="badge badge-info">
                        @Model.Uniformes.Count ítem(s)
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="tabla-sistema w-100">
                            <thead>
                                <tr>
                                    <th>Tipo uniforme</th>
                                    <th class="text-center" style="width:110px;">Talla</th>
                                    <th class="text-center" style="width:110px;">Cantidad</th>
                                    <th class="text-end" style="width:170px;">Costo (₡)</th>
                                    <th class="text-center" style="width:130px;">Cobrar planilla</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Uniformes.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input type="hidden"
                                                   asp-for="Uniformes[i].IdEntrega" />
                                            <select asp-for="Uniformes[i].IdTipoUniforme"
                                                    class="form-select"
                                                    asp-items="@(new SelectList(
                                                                                                                                                                Model.TiposUniforme,
                                                                                                                                                                "IdTipoUniforme",
                                                                                                                                                                "NombreTipo",
                                                                                                                                                                Model.Uniformes[i].IdTipoUniforme))">
                                        </select>
                                    </td>
                                    <td>
                                        <select asp-for="Uniformes[i].Talla"
                                                class="form-select">
                                            @foreach (var talla in Model.Tallas)
                                                {
                                                    @if (talla == Model.Uniformes[i].Talla)
                                                    {
                                                        <option value="@talla" selected="selected">
                                                            @talla
                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@talla">@talla</option>
                                                    }
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input asp-for="Uniformes[i].Cantidad"
                                                   class="form-control text-center"
                                                   type="number"
                                                   min="1" />
                                        </td>
                                        <td>
                                            <div class="input-group">
                                                <span class="input-group-text"
                                                      style="font-size:0.82rem;padding:4px 8px;">
                                                    ₡
                                                </span>
                                                <input asp-for="Uniformes[i].Costo"
                                                       class="form-control"
                                                       type="number"
                                                       step="0.01"
                                                       min="0" />
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <input asp-for="Uniformes[i].CobrarEnPlanilla"
                                                   type="checkbox"
                                                   class="form-check-input"
                                                   style="width:18px;height:18px;" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <hr class="section-divider" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i>Cancelar
                </a>
                <button type="button"
                        class="btn btn-warning"
                        onclick="confirmarGuardar()">
                    <i class="bi bi-check-circle"></i>Guardar cambios
                </button>
            </div>

        </div>
    </div>

</form>

@section Styles {
    <style>
        .required {
            color: var(--red);
            margin-left: 2px;
        }

        .input-group-text {
            background: var(--slate-l);
            border: 1.5px solid var(--border);
            border-right: none;
            color: var(--text-2);
            font-weight: 600;
        }

        .input-group .form-control {
            border-left: none;
        }

            .input-group .form-control:focus {
                border-left: none;
                box-shadow: none;
                border-color: var(--blue);
            }

        .input-group:focus-within .input-group-text {
            border-color: var(--blue);
        }
    </style>
}

@section Scripts {
    <script>

        // Contador observaciones con valor inicial
        var obs      = document.getElementById('inputObservaciones');
        var contador = document.getElementById('contadorObs');

        obs.addEventListener('input', function () {
            var len = obs.value.length;
            contador.textContent = len + ' / 300';
            contador.style.color = len > 300 ? 'var(--red)' : 'var(--text-3)';
            if (len > 300) obs.value = obs.value.substring(0, 300);
        });

        function confirmarGuardar() {
            Alert.confirm(
                'Se guardarán los cambios en la entrega de @Model.Uniformes.Count uniforme(s) para @Model.NombreColaborador. ¿Desea continuar?',
                function () {
                    document.getElementById('formEditar').submit();
                },
                'question'
            );
        }

    </script>
}