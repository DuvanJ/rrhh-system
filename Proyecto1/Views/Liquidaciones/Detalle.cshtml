@model List<Proyecto1.Models.LiquidacionDetalleVM>

@{
    ViewData["Title"] = "Detalle de Liquidación";
    var total = Model?.Sum(x => x.Monto) ?? 0;
}

<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-cash-stack"></i>Detalle de Liquidación #@ViewBag.IdLiquidacion
    </h3>
    <div class="d-flex gap-2">
        <a asp-action="ExportarPdf"
           asp-route-id="@ViewBag.IdLiquidacion"
           class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf"></i>Descargar PDF
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>Volver
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-6 col-lg-8">

        <div class="kpi-card mb-4">
            <div>
                <div class="kpi-label">Total liquidación</div>
                <div class="kpi-value" style="font-size:1.6rem;color:var(--green)">
                    ₡ @total.ToString("N2")
                </div>
                <div class="kpi-trend up" style="font-size:0.72rem;">
                    @(Model?.Count ?? 0) rubros incluidos
                </div>
            </div>
            <div class="kpi-icon green">
                <i class="bi bi-cash-coin"></i>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-header-title">
                    <i class="bi bi-list-check"></i>Rubros de la liquidación
                </span>
                <span class="badge badge-info">@(Model?.Count ?? 0) rubros</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="tabla-sistema w-100">
                        <thead>
                            <tr>
                                <th>Rubro</th>
                                <th class="text-end pe-3">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="font-weight:500;">@item.Rubro</td>
                                        <td class="text-end td-mono pe-3"
                                            style="color:var(--green);font-weight:600;">
                                            ₡ @item.Monto.ToString("N2")
                                        </td>
                                    </tr>
                                }
                                <tr style="background:var(--slate-l);
                                                       border-top:2px solid var(--border);">
                                    <td style="font-weight:700;font-size:0.9rem;
                                                           color:var(--navy);padding:14px;">
                                        <i class="bi bi-calculator me-2"
                                           style="color:var(--blue)"></i>TOTAL
                                    </td>
                                    <td class="text-end td-mono pe-3"
                                        style="font-weight:700;font-size:1.1rem;
                                                           color:var(--green);padding:14px;">
                                        ₡ @total.ToString("N2")
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2">
                                        <div class="table-empty">
                                            <i class="bi bi-cash-stack"></i>
                                            <p>No existen rubros para esta liquidación</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end"
                 style="background:transparent;border-top:1px solid var(--border);
                        padding:16px 20px;">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>Volver al listado
                </a>
            </div>
        </div>

    </div>
</div>