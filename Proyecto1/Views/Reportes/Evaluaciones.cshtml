@model List<Proyecto1.Models.EvaluacionVM>

@{
    ViewData["Title"] = "Reporte de Evaluaciones";

    var colaboradorQ = Context.Request.Query["colaborador"].ToString();
    var fechaInicioQ = Context.Request.Query["fechaInicio"].ToString();
    var fechaFinQ = Context.Request.Query["fechaFin"].ToString();

    var totalEval = (int)(ViewBag.TotalEvaluaciones ?? 0);
    var promedio = ViewBag.PromedioPuntaje?.ToString() ?? "—";
    var mejorPuntaje = ViewBag.MejorPuntaje?.ToString() ?? "—";
    var tendencia = ViewBag.Tendencia?.ToString() ?? "—";
}

@* ================================================
   HEADER
   ================================================ *@
<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-clipboard-data"></i>Reporte de Evaluaciones
    </h3>
    <a asp-controller="Reportes" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>Volver
    </a>
</div>

@* ================================================
   FILTROS
   ================================================ *@
<div class="filter-card mb-4">
    <form method="get">
        <div class="filter-row flex-wrap">

            <div class="filter-group" style="max-width:240px;">
                <span class="filter-label">Colaborador</span>
                <input type="text"
                       name="colaborador"
                       value="@colaboradorQ"
                       class="form-control"
                       placeholder="Nombre..." />
            </div>

            <div class="filter-group" style="max-width:160px;">
                <span class="filter-label">Fecha inicio</span>
                <input type="date"
                       name="fechaInicio"
                       value="@fechaInicioQ"
                       class="form-control" />
            </div>

            <div class="filter-group" style="max-width:160px;">
                <span class="filter-label">Fecha fin</span>
                <input type="date"
                       name="fechaFin"
                       value="@fechaFinQ"
                       class="form-control" />
            </div>

            <div class="filter-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i>Filtrar
                </button>
                <a asp-action="Evaluaciones" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i>Limpiar
                </a>
            </div>

        </div>
    </form>
</div>

@* ================================================
   KPI CARDS
   ================================================ *@
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total evaluaciones</div>
                <div class="kpi-value">@totalEval</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-clipboard-check"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Promedio puntaje</div>
                <div class="kpi-value" style="color:var(--blue)">@promedio</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-bar-chart-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Mejor puntaje</div>
                <div class="kpi-value" style="color:var(--green)">@mejorPuntaje</div>
            </div>
            <div class="kpi-icon green">
                <i class="bi bi-star-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Tendencia</div>
                <div class="kpi-value" style="font-size:1rem;">@tendencia</div>
            </div>
            <div class="kpi-icon amber">
                <i class="bi bi-graph-up"></i>
            </div>
        </div>
    </div>

</div>

@* ================================================
   BOTON EXCEL
   ================================================ *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted" style="font-size:0.82rem;">
        @Model.Count evaluacion(es) encontrada(s)
    </span>
    <a asp-action="ExportarEvaluacionesExcel"
       asp-route-colaborador="@colaboradorQ"
       asp-route-fechaInicio="@fechaInicioQ"
       asp-route-fechaFin="@fechaFinQ"
       class="btn btn-success">
        <i class="bi bi-file-earmark-excel"></i>Exportar Excel
    </a>
</div>

@* ================================================
   TABLA
   ================================================ *@
<div class="card mb-4">
    <div class="card-header">
        <span class="card-header-title">
            <i class="bi bi-table"></i>Historial de evaluaciones
        </span>
        <span class="badge badge-info">@Model.Count registros</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaEvaluaciones" class="tabla-sistema w-100">
                <thead>
                    <tr>
                        <th>Colaborador</th>
                        <th class="text-center">Fecha</th>
                        <th class="text-center">Puntaje</th>
                        <th>Comentarios</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var iniciales = item.NombreColaborador?
                            .Split(' ')
                            .Where(s => !string.IsNullOrEmpty(s))
                            .Take(2)
                            .Select(s => s[0].ToString())
                            .Aggregate("", (acc, c) => acc + c)
                            .ToUpper() ?? "??";

                            string avatarColor;
                            string badgeClass;

                            if (item.PuntajeTotal >= 90)
                            {
                                avatarColor = "green";
                                badgeClass = "bg-success";
                            }
                            else if (item.PuntajeTotal >= 70)
                            {
                                avatarColor = "blue";
                                badgeClass = "bg-info";
                            }
                            else if (item.PuntajeTotal >= 50)
                            {
                                avatarColor = "amber";
                                badgeClass = "bg-warning";
                            }
                            else
                            {
                                avatarColor = "red";
                                badgeClass = "bg-danger";
                            }

                    <tr>
                        <td>
                            <div class="table-avatar">
                                <div class="avatar-circle avatar-@avatarColor">
                                    @iniciales
                                </div>
                                <div class="avatar-name">@item.NombreColaborador</div>
                            </div>
                        </td>
                        <td class="text-center td-muted">
                            @item.FechaEvaluacion.ToString("dd/MM/yyyy")
                        </td>
                        <td class="text-center">
                            <div class="puntaje-bar">
                                <span class="puntaje-valor">
                                    @(item.PuntajeTotal?.ToString("N1") ?? "—")
                                </span>
                                <div class="puntaje-track">
                                    <div class="puntaje-fill @avatarColor"
                                         style="width:@(item.PuntajeTotal ?? 0)%"></div>
                                </div>
                            </div>
                        </td>
                        <td class="td-muted" style="max-width:220px;">
                            @(string.IsNullOrEmpty(item.ComentariosGenerales)
                                                        ? "—"
                                                        : item.ComentariosGenerales.Length > 60
                                                        ? item.ComentariosGenerales.Substring(0, 60) + "..."
                                                        : item.ComentariosGenerales)
                        </td>
                    </tr>
                                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="table-empty">
                                    <i class="bi bi-clipboard-x"></i>
                                    <p>No se encontraron evaluaciones</p>
                                    <span class="text-muted" style="font-size:0.82rem;">
                                        Ajuste los filtros e intente de nuevo
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ================================================
   GRAFICO
   ================================================ *@
<div class="card">
    <div class="card-header">
        <span class="card-header-title">
            <i class="bi bi-graph-up"></i>Evolucion del desempeno
        </span>
    </div>
    <div class="card-body">
        <canvas id="graficoEvaluaciones" height="80"></canvas>
    </div>
</div>

@section Styles {
    <style>
        .puntaje-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            justify-content: center;
        }

        .puntaje-valor {
            font-family: 'Consolas', monospace;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text);
            min-width: 28px;
            text-align: right;
        }

        .puntaje-track {
            flex: 1;
            max-width: 80px;
            height: 6px;
            background: var(--border);
            border-radius: 10px;
            overflow: hidden;
        }

        .puntaje-fill {
            height: 100%;
            border-radius: 10px;
        }

            .puntaje-fill.green {
                background: var(--green);
            }

            .puntaje-fill.blue {
                background: var(--blue);
            }

            .puntaje-fill.amber {
                background: var(--amber);
            }

            .puntaje-fill.red {
                background: var(--red);
            }
    </style>
}

@section Scripts {
    <script>

        $(document).ready(function () {
            if (@Model.Any().ToString().ToLower()) {
                var config = Object.assign({}, DataTableConfig, {
                    order: [[1, 'desc']]
                });
                $('#tablaEvaluaciones').DataTable(config);
            }
        });

        var etiquetas = [@Html.Raw(string.Join(",",
                    Model.Select(x => $"\"{x.FechaEvaluacion.ToString("dd/MM/yyyy")}\"")))];

    var datos = [@string.Join(",",
                Model.Select(x => (x.PuntajeTotal ?? 0).ToString()))];

    new Chart(document.getElementById('graficoEvaluaciones'), {
        type: 'line',
        data: {
            labels: etiquetas,
            datasets: [{
                label: 'Puntaje evaluacion',
                data: datos,
                borderColor: '#2563eb',
                backgroundColor: 'rgba(37,99,235,0.08)',
                borderWidth: 2,
                pointRadius: 4,
                pointBackgroundColor: '#2563eb',
                tension: 0.3,
                fill: true
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: {
                    beginAtZero: true,
                    max: 100,
                    grid: { color: '#f1f5f9' },
                    ticks: { color: '#94a3b8', font: { size: 11 } }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: '#64748b', font: { size: 11 } }
                }
            }
        }
    });

    </script>
}