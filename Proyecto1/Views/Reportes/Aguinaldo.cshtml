@model List<Proyecto1.Models.Aguinaldo>

@{
    ViewData["Title"] = "Reporte de Aguinaldos";

    var totalSalarios = Model.Sum(x => x.TotalSalarios);
    var totalAguinaldo = Model.Sum(x => x.MontoAguinaldo);
    var totalColaboradores = Model.Count();
}

@* ================================================
   HEADER
   ================================================ *@
<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-cash-stack"></i>Reporte de Aguinaldos
    </h3>
    <div class="d-flex gap-2">
        
        <a asp-controller="Reportes" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>Volver
        </a>
    </div>
</div>

@* ================================================
   FILTROS
   ================================================ *@
<div class="filter-card mb-4">
    <form method="get" asp-action="Aguinaldo">
        <div class="filter-row">

            <div class="filter-group" style="max-width:140px;">
                <span class="filter-label">Año</span>
                <input type="number"
                       name="anio"
                       value="@ViewBag.Anio"
                       class="form-control"
                       placeholder="@DateTime.Now.Year" />
            </div>

            <div class="filter-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i>Filtrar
                </button>
                <a asp-action="Aguinaldo" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i>Limpiar
                </a>
            </div>

        </div>
    </form>
</div>

@* ================================================
   KPI CARDS
   ================================================ *@
<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Colaboradores</div>
                <div class="kpi-value">@totalColaboradores</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-people-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total salarios</div>
                <div class="kpi-value" style="font-size:1.1rem;color:var(--blue)">
                    ₡ @totalSalarios.ToString("N2")
                </div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-cash-coin"></i>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total aguinaldo</div>
                <div class="kpi-value" style="font-size:1.1rem;color:var(--green)">
                    ₡ @totalAguinaldo.ToString("N2")
                </div>
            </div>
            <div class="kpi-icon green">
                <i class="bi bi-cash-stack"></i>
            </div>
        </div>
    </div>

</div>


<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted" style="font-size:0.82rem;">
        @totalColaboradores registro(s) encontrado(s)
    </span>
    <a asp-action="ExportarAguinaldoExcel"
       asp-route-anio="@ViewBag.Anio"
       class="btn btn-success">
        <i class="bi bi-file-earmark-excel"></i>Exportar Excel
    </a>
</div>


@* ================================================
   TABLA
   ================================================ *@
<div class="card">
    <div class="card-header">
        <span class="card-header-title">
            <i class="bi bi-table"></i>
            Aguinaldos @(ViewBag.Anio != null ? ViewBag.Anio.ToString() : "— Todos los periodos")
        </span>
        <span class="badge badge-info">@totalColaboradores registros</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaAguinaldo" class="tabla-sistema w-100">
                <thead>
                    <tr>
                        <th>Colaborador</th>
                        <th class="text-center">Año</th>
                        <th class="text-end">Total salarios</th>
                        <th class="text-end">Monto aguinaldo</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Fecha calculo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var iniciales = item.NombreColaborador?
                            .Split(' ')
                            .Where(s => !string.IsNullOrEmpty(s))
                            .Take(2)
                            .Select(s => s[0].ToString())
                            .Aggregate("", (acc, c) => acc + c)
                            .ToUpper() ?? "??";

                            <tr>
                                <td>
                                    <div class="table-avatar">
                                        <div class="avatar-circle avatar-blue">
                                            @iniciales
                                        </div>
                                        <div class="avatar-name">@item.NombreColaborador</div>
                                    </div>
                                </td>
                                <td class="text-center td-mono">@item.Año</td>
                                <td class="text-end td-mono">
                                    ₡ @item.TotalSalarios.ToString("N2")
                                </td>
                                <td class="text-end td-mono"
                                    style="font-weight:700;color:var(--green)">
                                    ₡ @item.MontoAguinaldo.ToString("N2")
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info badge-dot">@item.Estado</span>
                                </td>
                                <td class="text-center td-muted">
                                    @(item.FechaCalculo?.ToString("dd/MM/yyyy") ?? "—")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="table-empty">
                                    <i class="bi bi-cash-stack"></i>
                                    <p>No se encontraron registros de aguinaldo</p>
                                    <span class="text-muted" style="font-size:0.82rem;">
                                        Intente con un año diferente
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

                @if (Model.Any())
                {
                    <tfoot>
                        <tr style="background:var(--slate-l);
                                       border-top:2px solid var(--border);">
                            <td colspan="2"
                                style="font-weight:700;color:var(--navy);padding:12px 14px;">
                                <i class="bi bi-calculator me-1"
                                   style="color:var(--blue)"></i>TOTALES
                            </td>
                            <td class="text-end td-mono"
                                style="font-weight:700;padding:12px 14px;">
                                ₡ @totalSalarios.ToString("N2")
                            </td>
                            <td class="text-end td-mono"
                                style="font-weight:700;color:var(--green);
                                           font-size:1rem;padding:12px 14px;">
                                ₡ @totalAguinaldo.ToString("N2")
                            </td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (@Model.Any().ToString().ToLower()) {
                var config = Object.assign({}, DataTableConfig, {
                    order: [[1, 'desc']]
                });
                $('#tablaAguinaldo').DataTable(config);
            }
        });
    </script>
}