<div class="row g-4">

    <div class="col-12">
        <h4 class="fw-bold mb-3">Gestión de Recursos Humanos</h4>
    </div>

    @{
        var rrhh = new[]
        {
        new { T = "Planillas", I = "bi-cash-stack", C = "", A = "" },
        new { T = "Horas Extras", I = "bi-clock-history", C = "HorasExtras", A = "Index" },
        new { T = "Aguinaldo", I = "bi-gift", C = "", A = "" },
        new { T = "Incapacidades", I = "bi-hospital", C = "", A = "" },
        new { T = "Liquidación", I = "bi-file-earmark-text", C = "", A = "" },
        new { T = "Permisos", I = "bi-journal-check", C = "Permisos", A = "Index" },
        new { T = "Vacaciones", I = "bi-sun", C = "Vacaciones", A = "Index" },
        new { T = "Asistencia", I = "bi-calendar-check", C = "Asistencia", A = "Index" },
        new { T = "Entrega de Uniformes", I = "bi-box-seam", C = "", A = "" },
        new { T = "Evaluar Rendimiento", I = "bi-graph-up-arrow", C = "", A = "" }
        };
    }

    @foreach (var m in rrhh)
    {
        <div class="col-md-3">
            @if (!string.IsNullOrEmpty(m.C))
            {
                <a asp-controller="@m.C"
                   asp-action="@m.A"
                   class="text-decoration-none">
                    <div class="card shadow-sm h-100 dashboard-card">
                        <div class="card-body text-center">
                            <i class="bi @m.I fs-1 text-primary"></i>
                            <h6 class="mt-3">@m.T</h6>
                        </div>
                    </div>
                </a>
            }
            else
            {
                <div class="card shadow-sm h-100 dashboard-card opacity-50">
                    <div class="card-body text-center">
                        <i class="bi @m.I fs-1 text-secondary"></i>
                        <h6 class="mt-3">@m.T</h6>
                        <small class="text-muted">Próximamente</small>
                    </div>
                </div>
            }
        </div>
    }

</div>
