@{
    ViewData["Title"] = "Panel de Recursos Humanos";
}

@* ================================================
   HEADER
   ================================================ *@
<div class="page-header">
    <div>
        <h3 class="page-title">
            <i class="bi bi-person-lines-fill"></i>Panel de Recursos Humanos
        </h3>
        <small class="text-muted">
            Sistema de Gestión RRHH &middot; @DateTime.Now.ToString("dd MMMM yyyy")
        </small>
    </div>
</div>

@* ================================================
   KPI CARDS - 8 KPIs PARA RRHH
   ================================================ *@
<div class="row g-3 mb-5">


    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Planillas activas</div>
                <div class="kpi-value">@(ViewBag.TotalPlanillas ?? 0)</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Registros asistencia</div>
                <div class="kpi-value">@(ViewBag.TotalAsistencias ?? 0)</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-fingerprint"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Horas extras pendientes</div>
                <div class="kpi-value text-warning">@(ViewBag.HorasExtrasPendientes ?? 0)</div>
            </div>
            <div class="kpi-icon amber">
                <i class="bi bi-alarm"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Permisos pendientes</div>
                <div class="kpi-value text-warning">@(ViewBag.PermisosPendientes ?? 0)</div>
            </div>
            <div class="kpi-icon amber">
                <i class="bi bi-calendar-event"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Vacaciones pendientes</div>
                <div class="kpi-value text-warning">@(ViewBag.VacacionesPendientes ?? 0)</div>
            </div>
            <div class="kpi-icon amber">
                <i class="bi bi-sun"></i>
            </div>
        </div>
    </div>


    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Liquidaciones pendientes</div>
                <div class="kpi-value text-warning">@(ViewBag.LiquidacionesPendientes ?? 0)</div>
            </div>
            <div class="kpi-icon amber">
                <i class="bi bi-cash-stack"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Aguinaldos pendientes</div>
                <div class="kpi-value text-warning">@(ViewBag.AguinaldosPendientes ?? 0)</div>
            </div>
            <div class="kpi-icon amber">
                <i class="bi bi-currency-dollar"></i>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Incapacidades activas</div>
                <div class="kpi-value text-danger">@(ViewBag.IncapacidadesActivas ?? 0)</div>
            </div>
            <div class="kpi-icon red">
                <i class="bi bi-heart-pulse"></i>
            </div>
        </div>
    </div>

</div>

@* ================================================
   SECCIÓN: OPERACIONES
   ================================================ *@
<div class="dashboard-section-header">
    <div class="dashboard-section-icon blue">
        <i class="bi bi-gear-fill"></i>
    </div>
    <div>
        <h5 class="dashboard-section-title">Operaciones</h5>
        <span class="dashboard-section-sub">Planillas, pagos y liquidaciones</span>
    </div>
</div>

<div class="row g-3 mb-5">

    <div class="col-xl-2 col-lg-3 col-md-4 col-6">
        <a asp-controller="Planillas" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon blue">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
            <span class="dashboard-card-label">Planillas</span>
            @if ((ViewBag.TotalPlanillas ?? 0) > 0)
            {
                <span class="dashboard-card-badge">@ViewBag.TotalPlanillas</span>
            }
        </a>
    </div>

    <div class="col-xl-2 col-lg-3 col-md-4 col-6">
        <a asp-controller="HorasExtras" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon blue">
                <i class="bi bi-alarm"></i>
            </div>
            <span class="dashboard-card-label">Horas Extras</span>
            @if ((ViewBag.HorasExtrasPendientes ?? 0) > 0)
            {
                <span class="dashboard-card-badge amber">@ViewBag.HorasExtrasPendientes</span>
            }
        </a>
    </div>

    <div class="col-xl-2 col-lg-3 col-md-4 col-6">
        <a asp-controller="Aguinaldo" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon blue">
                <i class="bi bi-currency-dollar"></i>
            </div>
            <span class="dashboard-card-label">Aguinaldo</span>
            @if ((ViewBag.AguinaldosPendientes ?? 0) > 0)
            {
                <span class="dashboard-card-badge amber">@ViewBag.AguinaldosPendientes</span>
            }
        </a>
    </div>

    <div class="col-xl-2 col-lg-3 col-md-4 col-6">
        <a asp-controller="Incapacidades" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon blue">
                <i class="bi bi-heart-pulse"></i>
            </div>
            <span class="dashboard-card-label">Incapacidades</span>
            @if ((ViewBag.IncapacidadesActivas ?? 0) > 0)
            {
                <span class="dashboard-card-badge red">@ViewBag.IncapacidadesActivas</span>
            }
        </a>
    </div>

    <div class="col-xl-2 col-lg-3 col-md-4 col-6">
        <a asp-controller="Liquidaciones" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon blue">
                <i class="bi bi-cash-stack"></i>
            </div>
            <span class="dashboard-card-label">Liquidaciones</span>
            @if ((ViewBag.LiquidacionesPendientes ?? 0) > 0)
            {
                <span class="dashboard-card-badge amber">@ViewBag.LiquidacionesPendientes</span>
            }
        </a>
    </div>

</div>

@* ================================================
   SECCIÓN: GESTIÓN
   ================================================ *@
<div class="dashboard-section-header">
    <div class="dashboard-section-icon green">
        <i class="bi bi-person-lines-fill"></i>
    </div>
    <div>
        <h5 class="dashboard-section-title">Gestión</h5>
        <span class="dashboard-section-sub">Permisos, vacaciones y asistencia</span>
    </div>
</div>

<div class="row g-3 mb-5">

    <div class="col-xl-2 col-lg-3 col-md-4 col-6">
        <a asp-controller="Permisos" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon green">
                <i class="bi bi-calendar-event"></i>
            </div>
            <span class="dashboard-card-label">Permisos</span>
            @if ((ViewBag.PermisosPendientes ?? 0) > 0)
            {
                <span class="dashboard-card-badge amber">@ViewBag.PermisosPendientes</span>
            }
        </a>
    </div>

    <div class="col-xl-2 col-lg-3 col-md-4 col-6">
        <a asp-controller="Vacaciones" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon green">
                <i class="bi bi-sun"></i>
            </div>
            <span class="dashboard-card-label">Vacaciones</span>
            @if ((ViewBag.VacacionesPendientes ?? 0) > 0)
            {
                <span class="dashboard-card-badge amber">@ViewBag.VacacionesPendientes</span>
            }
        </a>
    </div>

    <div class="col-xl-2 col-lg-3 col-md-4 col-6">
        <a asp-controller="Asistencia" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon green">
                <i class="bi bi-fingerprint"></i>
            </div>
            <span class="dashboard-card-label">Asistencia</span>
        </a>
    </div>

    <div class="col-xl-2 col-lg-3 col-md-4 col-6">
        <a asp-controller="Evaluacion" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon green">
                <i class="bi bi-clipboard-check"></i>
            </div>
            <span class="dashboard-card-label">Evaluaciones</span>
        </a>
    </div>

    <div class="col-xl-2 col-lg-3 col-md-4 col-6">
        <a asp-controller="Uniformes" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon green">
                <i class="bi bi-bag-check"></i>
            </div>
            <span class="dashboard-card-label">Uniformes</span>
        </a>
    </div>

</div>

@* ================================================
   SECCIÓN: ANÁLISIS
   ================================================ *@
<div class="dashboard-section-header">
    <div class="dashboard-section-icon slate">
        <i class="bi bi-bar-chart-line"></i>
    </div>
    <div>
        <h5 class="dashboard-section-title">Análisis</h5>
        <span class="dashboard-section-sub">Consultas y reportes del sistema</span>
    </div>
</div>

<div class="row g-3 mb-4">

    <div class="col-xl-2 col-lg-3 col-md-4 col-6">
        <a asp-controller="Consultas" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon slate">
                <i class="bi bi-search"></i>
            </div>
            <span class="dashboard-card-label">Consultas</span>
        </a>
    </div>

    <div class="col-xl-2 col-lg-3 col-md-4 col-6">
        <a asp-controller="Reportes" asp-action="Index" class="dashboard-card">
            <div class="dashboard-card-icon slate">
                <i class="bi bi-bar-chart-line"></i>
            </div>
            <span class="dashboard-card-label">Reportes</span>
        </a>
    </div>

</div>