@{
    ViewData["Title"] = "Panel Principal";
    var rol = Context.Session.GetString("Perfil");
}

<h3 class="mb-4 fw-bold">Panel Principal</h3>

<div class="row g-4">

    @if (rol == "Administrador")
    {
        @Html.Partial("_DashboardAdministrador")
    }

    @if (rol == "RRHH")
    {
        @Html.Partial("_DashboardRRHH")
    }

    @if (rol == "Colaborador")
    {
        @Html.Partial("_DashboardColaborador")
    }

</div>
