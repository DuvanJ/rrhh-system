@{
    ViewData["Title"] = "Política de Privacidad";
}

<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-shield-lock"></i>Política de Privacidad
    </h3>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>Volver
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div style="max-width: 900px; margin: 0 auto; line-height: 1.8;">

            <!-- Introducción -->
            <section class="mb-5">
                <h4 style="color: var(--navy); font-weight: 700; margin-bottom: 12px;">
                    <i class="bi bi-info-circle" style="color: var(--blue); margin-right: 8px;"></i>
                    Introducción
                </h4>
                <p style="color: var(--text-2); font-size: 0.9rem;">
                    En <strong>Sistema RRHH</strong>, nos comprometemos a proteger tu privacidad y garantizar que entiendas cómo recopilamos, usamos y compartimos tu información personal. Esta política de privacidad describe nuestras prácticas con respecto a la recopilación y el uso de datos.
                </p>
            </section>

            <!-- Información que recopilamos -->
            <section class="mb-5">
                <h4 style="color: var(--navy); font-weight: 700; margin-bottom: 12px;">
                    <i class="bi bi-database" style="color: var(--blue); margin-right: 8px;"></i>
                    Información que Recopilamos
                </h4>
                <p style="color: var(--text-2); font-size: 0.9rem; margin-bottom: 12px;">
                    Recopilamos información de varias formas:
                </p>
                <ul style="color: var(--text-2); font-size: 0.9rem; padding-left: 24px;">
                    <li style="margin-bottom: 8px;">
                        <strong>Información de Registro:</strong> Nombre, correo electrónico, teléfono, cédula de identidad y otros datos de contacto.
                    </li>
                    <li style="margin-bottom: 8px;">
                        <strong>Información de Empleo:</strong> Posición, departamento, historial laboral, evaluaciones de desempeño y registros de asistencia.
                    </li>
                    <li style="margin-bottom: 8px;">
                        <strong>Información Transaccional:</strong> Registros de salarios, beneficios, gastos y liquidaciones.
                    </li>
                    <li>
                        <strong>Información de Uso:</strong> Cómo interactúas con nuestro sistema, incluidas las acciones realizadas y los tiempos de acceso.
                    </li>
                </ul>
            </section>

            <!-- Cómo usamos la información -->
            <section class="mb-5">
                <h4 style="color: var(--navy); font-weight: 700; margin-bottom: 12px;">
                    <i class="bi bi-gear" style="color: var(--blue); margin-right: 8px;"></i>
                    Cómo Usamos Tu Información
                </h4>
                <p style="color: var(--text-2); font-size: 0.9rem; margin-bottom: 12px;">
                    Utilizamos tu información para:
                </p>
                <ul style="color: var(--text-2); font-size: 0.9rem; padding-left: 24px;">
                    <li style="margin-bottom: 8px;">Administrar tu cuenta de empleado</li>
                    <li style="margin-bottom: 8px;">Procesar nóminas, beneficios y compensaciones</li>
                    <li style="margin-bottom: 8px;">Realizar seguimiento de asistencia y desempeño</li>
                    <li style="margin-bottom: 8px;">Cumplir con obligaciones legales y normativas</li>
                    <li style="margin-bottom: 8px;">Mejorar la seguridad y el funcionamiento del sistema</li>
                    <li>Comunicarnos contigo sobre actualizaciones importantes</li>
                </ul>
            </section>

            <!-- Compartición de datos -->
            <section class="mb-5">
                <h4 style="color: var(--navy); font-weight: 700; margin-bottom: 12px;">
                    <i class="bi bi-share" style="color: var(--blue); margin-right: 8px;"></i>
                    Compartición de Datos
                </h4>
                <p style="color: var(--text-2); font-size: 0.9rem;">
                    No compartimos tu información personal con terceros sin tu consentimiento, excepto cuando sea requerido por la ley o para cumplir con regulaciones gubernamentales. Tu información está disponible únicamente para el personal autorizado de Recursos Humanos y Administración.
                </p>
            </section>

            <!-- Seguridad -->
            <section class="mb-5">
                <h4 style="color: var(--navy); font-weight: 700; margin-bottom: 12px;">
                    <i class="bi bi-lock" style="color: var(--green); margin-right: 8px;"></i>
                    Seguridad de Datos
                </h4>
                <p style="color: var(--text-2); font-size: 0.9rem;">
                    Implementamos medidas de seguridad técnicas y administrativas para proteger tu información contra acceso no autorizado, alteración, divulgación o destrucción. Esto incluye encriptación, autenticación de múltiples factores y controles de acceso basados en roles.
                </p>
            </section>

            <!-- Derechos del usuario -->
            <section class="mb-5">
                <h4 style="color: var(--navy); font-weight: 700; margin-bottom: 12px;">
                    <i class="bi bi-person-check" style="color: var(--blue); margin-right: 8px;"></i>
                    Tus Derechos
                </h4>
                <p style="color: var(--text-2); font-size: 0.9rem; margin-bottom: 12px;">
                    Tienes derecho a:
                </p>
                <ul style="color: var(--text-2); font-size: 0.9rem; padding-left: 24px;">
                    <li style="margin-bottom: 8px;">Acceder a tu información personal</li>
                    <li style="margin-bottom: 8px;">Solicitar correcciones a datos inexactos</li>
                    <li style="margin-bottom: 8px;">Solicitar la eliminación de tu información (sujeto a retención legal)</li>
                    <li>Presentar una reclamación a la autoridad de protección de datos</li>
                </ul>
            </section>

            <!-- Cambios en la política -->
            <section class="mb-5">
                <h4 style="color: var(--navy); font-weight: 700; margin-bottom: 12px;">
                    <i class="bi bi-arrow-repeat" style="color: var(--blue); margin-right: 8px;"></i>
                    Cambios en Esta Política
                </h4>
                <p style="color: var(--text-2); font-size: 0.9rem;">
                    Nos reservamos el derecho de actualizar esta política de privacidad en cualquier momento. Los cambios entrarán en vigor cuando se publiquen en esta página. Te recomendamos que revises esta política periódicamente para mantenerte informado sobre cómo protegemos tu información.
                </p>
            </section>

            <!-- Contacto -->
            <section class="mb-3">
                <h4 style="color: var(--navy); font-weight: 700; margin-bottom: 12px;">
                    <i class="bi bi-envelope" style="color: var(--blue); margin-right: 8px;"></i>
                    Contacto
                </h4>
                <p style="color: var(--text-2); font-size: 0.9rem; margin-bottom: 8px;">
                    Si tienes preguntas sobre esta política de privacidad o nuestras prácticas de privacidad, contáctate con:
                </p>
                <div style="background: #f8fafc; border-left: 4px solid var(--blue); padding: 12px 16px; border-radius: var(--radius); margin-top: 12px;">
                    <p style="margin: 0; color: var(--text); font-weight: 500; font-size: 0.9rem;">
                        <i class="bi bi-person-fill" style="color: var(--blue); margin-right: 6px;"></i>
                        Departamento de Recursos Humanos
                    </p>
                    <p style="margin: 4px 0 0 0; color: var(--text-2); font-size: 0.85rem;">
                        <i class="bi bi-envelope-fill" style="color: var(--blue); margin-right: 6px;"></i>
                        rrhh@empresa.com
                    </p>
                </div>
            </section>

            <!-- Footer -->
            <hr style="border: none; border-top: 1px solid var(--border); margin: 32px 0;">
            <p style="color: var(--text-3); font-size: 0.78rem; text-align: center; margin: 0;">
                <strong>Última actualización:</strong> @DateTime.Now.ToString("dd/MM/yyyy")
            </p>

        </div>
    </div>
</div>