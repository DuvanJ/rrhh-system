@model Proyecto1.Models.Colaborador

@{
    ViewData["Title"] = "Editar Colaborador";
    var iniciales = $"{Model.Nombre?.Substring(0, 1)}{Model.Apellidos?.Substring(0, 1)}".ToUpper();
    var colores = new[] { "blue", "green", "amber", "slate" };
    var color = colores[Model.IdColaborador % colores.Length];
}

<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-pencil-square"></i>Editar Colaborador
    </h3>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>Volver
    </a>
</div>

@* ========== MENSAJE DE ERROR GENERAL ========== *@
@if (TempData["Error"] != null)
{
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <div class="d-flex align-items-start gap-3">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 1.2rem; flex-shrink: 0; margin-top: 2px;"></i>
                    <div style="flex: 1;">
                        <strong>Validación de datos</strong>
                        <div style="margin-top: 6px; font-size: 0.9rem;">
                            @TempData["Error"]
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-10">

        @* Tarjeta de identidad del colaborador *@
        <div class="card mb-3">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-circle avatar-@color" style="width:48px;height:48px;font-size:1rem;">
                        @iniciales
                    </div>
                    <div>
                        <div class="fw-600" style="font-size:1rem;color:var(--text)">
                            @Model.Nombre @Model.Apellidos
                        </div>
                        <div style="font-size:0.82rem;color:var(--text-3)">
                            ID: @Model.IdColaborador &nbsp;·&nbsp; Cédula: @Model.Cedula
                        </div>
                    </div>
                    <div class="ms-auto">
                        @if (Model.Estado)
                        {
                            <span class="badge bg-success badge-dot">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger badge-dot">Inactivo</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Formulario *@
        <div class="card">
            <div class="card-header">
                <span class="card-header-title">
                    <i class="bi bi-person-vcard"></i>Información del colaborador
                </span>
            </div>
            <div class="card-body">
                <form method="post" id="formEditar" novalidate>

                    <input type="hidden" asp-for="IdColaborador" />

                    @* Fila 1: Cédula y Correo *@
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">
                                Cédula <span class="required">*</span>
                            </label>
                            <input asp-for="Cedula"
                                   id="inputCedula"
                                   class="form-control @(ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("Cedula") ? "input-validation-error" : "")"
                                   placeholder="Ej: 1-2345-6789 o 12-3456-7890-1234"
                                   maxlength="15" />
                            @if (ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("Cedula"))
                            {
                                <div class="form-error">
                                    @foreach (var error in ((Dictionary<string, List<string>>)ViewBag.Errores)["Cedula"])
                                    {
                                        <div>• @error</div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Correo electrónico</label>
                            <input asp-for="Correo"
                                   class="form-control @(ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("Correo") ? "input-validation-error" : "")"
                                   placeholder="correo@empresa.com"
                                   type="email" />
                            @if (ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("Correo"))
                            {
                                <div class="form-error">
                                    @foreach (var error in ((Dictionary<string, List<string>>)ViewBag.Errores)["Correo"])
                                    {
                                        <div>• @error</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @* Fila 2: Nombre y Apellidos *@
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">
                                Nombre <span class="required">*</span>
                            </label>
                            <input asp-for="Nombre"
                                   id="inputNombre"
                                   class="form-control @(ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("Nombre") ? "input-validation-error" : "")"
                                   placeholder="Nombre" />
                            @if (ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("Nombre"))
                            {
                                <div class="form-error">
                                    @foreach (var error in ((Dictionary<string, List<string>>)ViewBag.Errores)["Nombre"])
                                    {
                                        <div>• @error</div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Apellidos <span class="required">*</span>
                            </label>
                            <input asp-for="Apellidos"
                                   id="inputApellidos"
                                   class="form-control @(ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("Apellidos") ? "input-validation-error" : "")"
                                   placeholder="Apellidos" />
                            @if (ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("Apellidos"))
                            {
                                <div class="form-error">
                                    @foreach (var error in ((Dictionary<string, List<string>>)ViewBag.Errores)["Apellidos"])
                                    {
                                        <div>• @error</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @* Fila 3: Puesto y Departamento (DROPDOWNS) *@
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">
                                Puesto <span class="required">*</span>
                            </label>
                            <select asp-for="Puesto"
                                    class="form-select @(ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("Puesto") ? "input-validation-error" : "")"
                                    asp-items="new SelectList(ViewBag.Puestos)">
                                <option value="">-- Seleccionar puesto --</option>
                            </select>
                            @if (ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("Puesto"))
                            {
                                <div class="form-error">
                                    @foreach (var error in ((Dictionary<string, List<string>>)ViewBag.Errores)["Puesto"])
                                    {
                                        <div>• @error</div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Departamento <span class="required">*</span>
                            </label>
                            <select asp-for="Departamento"
                                    class="form-select @(ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("Departamento") ? "input-validation-error" : "")"
                                    asp-items="new SelectList(ViewBag.Departamentos)">
                                <option value="">-- Seleccionar departamento --</option>
                            </select>
                            @if (ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("Departamento"))
                            {
                                <div class="form-error">
                                    @foreach (var error in ((Dictionary<string, List<string>>)ViewBag.Errores)["Departamento"])
                                    {
                                        <div>• @error</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @* Fila 4: Fecha y Salario *@
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">
                                Fecha de ingreso <span class="required">*</span>
                            </label>
                            <input asp-for="FechaIngreso"
                                   type="date"
                                   class="form-control @(ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("FechaIngreso") ? "input-validation-error" : "")" />
                            @if (ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("FechaIngreso"))
                            {
                                <div class="form-error">
                                    @foreach (var error in ((Dictionary<string, List<string>>)ViewBag.Errores)["FechaIngreso"])
                                    {
                                        <div>• @error</div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Salario base <span class="required">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input asp-for="SalarioBase"
                                       class="form-control @(ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("SalarioBase") ? "input-validation-error" : "")"
                                       placeholder="0.00"
                                       type="number"
                                       step="0.01"
                                       min="0.01" />
                            </div>
                            @if (ViewBag.Errores != null && ((Dictionary<string, List<string>>)ViewBag.Errores).ContainsKey("SalarioBase"))
                            {
                                <div class="form-error">
                                    @foreach (var error in ((Dictionary<string, List<string>>)ViewBag.Errores)["SalarioBase"])
                                    {
                                        <div>• @error</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @* Estado *@
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label">Estado</label>
                            <div class="estado-toggle">
                                <input asp-for="Estado"
                                       class="form-check-input"
                                       type="checkbox"
                                       id="checkEstado"
                                       onchange="actualizarEstado(this)" />
                                <label class="form-check-label" for="checkEstado" id="labelEstado">
                                    @(Model.Estado ? "Colaborador activo" : "Colaborador inactivo")
                                </label>
                            </div>
                        </div>
                    </div>

                    <hr class="section-divider" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i>Cancelar
                        </a>
                        <button type="button" class="btn btn-warning" onclick="confirmarActualizar()">
                            <i class="bi bi-check-circle"></i>Guardar cambios
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Styles {
    <style>
        .required {
            color: var(--red);
            margin-left: 2px;
        }

        .alert-warning {
            background-color: #fffbeb;
            border: 1px solid #fde68a;
            color: #92400e;
            border-radius: var(--radius);
            padding: 16px;
            margin-bottom: 20px;
        }

            .alert-warning strong {
                font-size: 1rem;
                display: block;
                margin-bottom: 6px;
            }

        .form-error {
            color: var(--red);
            font-size: 0.78rem;
            margin-top: 6px;
            line-height: 1.6;
        }

            .form-error div {
                margin-bottom: 4px;
            }

        .input-validation-error {
            border-color: var(--red) !important;
            background-color: #fef2f2 !important;
        }

            .input-validation-error:focus {
                box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12) !important;
                border-color: var(--red) !important;
            }

        .form-select {
            border: 1.5px solid var(--border);
            border-radius: var(--radius);
            padding: 0.5rem 0.75rem;
            font-size: 0.95rem;
            background-color: var(--white);
            color: var(--text);
            cursor: pointer;
            transition: border-color 0.2s ease;
        }

            .form-select:hover {
                border-color: var(--text-3);
            }

            .form-select:focus {
                outline: none;
                border-color: var(--blue);
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            }

            .form-select.input-validation-error:focus {
                border-color: var(--red) !important;
                box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12) !important;
            }

        .input-group-text {
            background: var(--slate-l);
            border: 1.5px solid var(--border);
            border-right: none;
            color: var(--text-2);
            font-weight: 600;
            font-size: 0.9rem;
        }

        .input-group .form-control {
            border-left: none;
        }

            .input-group .form-control:focus {
                border-left: none;
                box-shadow: none;
                border-color: var(--blue);
            }

        .input-group .input-validation-error {
            border-right: none !important;
        }

        .input-group:focus-within .input-group-text {
            border-color: var(--blue);
        }

        .input-group:focus-within .input-validation-error + .input-group-text {
            border-color: var(--red);
        }

        .estado-toggle {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border: 1.5px solid var(--border);
            border-radius: var(--radius);
            background: var(--slate-ll);
            cursor: pointer;
            transition: border-color .15s ease;
        }

            .estado-toggle:hover {
                border-color: var(--border-d);
            }

            .estado-toggle .form-check-input {
                width: 18px;
                height: 18px;
                margin: 0;
                cursor: pointer;
                flex-shrink: 0;
            }

            .estado-toggle .form-check-label {
                font-size: 0.875rem;
                font-weight: 500;
                color: var(--text-2);
                cursor: pointer;
                margin: 0;
            }
    </style>
}

@section Scripts {
    <script>

        // ================================================
        // MÁSCARA AUTOMÁTICA DE CÉDULA
        // ================================================
        document.getElementById('inputCedula').addEventListener('input', function () {
            let val = this.value.replace(/[^\d-]/g, '');
            this.value = val;
        });

        // ================================================
        // SOLO LETRAS EN NOMBRE Y APELLIDOS
        // ================================================
        ['inputNombre', 'inputApellidos'].forEach(function (id) {
            document.getElementById(id).addEventListener('keypress', function (e) {
                const char = String.fromCharCode(e.which);
                if (!/[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/.test(char)) {
                    e.preventDefault();
                }
            });
        });

        // ================================================
        // TOGGLE ESTADO — actualiza el label en tiempo real
        // ================================================
        function actualizarEstado(checkbox) {
            const label  = document.getElementById('labelEstado');
            const toggle = checkbox.closest('.estado-toggle');
            if (checkbox.checked) {
                label.textContent        = 'Colaborador activo';
                toggle.style.borderColor = 'var(--green)';
                toggle.style.background  = 'var(--green-l)';
                label.style.color        = 'var(--green-t)';
            } else {
                label.textContent        = 'Colaborador inactivo';
                toggle.style.borderColor = 'var(--red)';
                toggle.style.background  = 'var(--red-l)';
                label.style.color        = 'var(--red-t)';
            }
        }

        // Inicializar color del toggle al cargar
        document.addEventListener('DOMContentLoaded', function () {
            const checkbox = document.getElementById('checkEstado');
            if (checkbox) actualizarEstado(checkbox);
        });

        // ================================================
        // CONFIRMACIÓN ANTES DE GUARDAR
        // ================================================
        function confirmarActualizar() {
            const nombre    = document.getElementById('inputNombre').value.trim();
            const apellidos = document.getElementById('inputApellidos').value.trim();
            const cedula    = document.getElementById('inputCedula').value.trim();

            if (!nombre || !apellidos || !cedula) {
                Alert.warning('Por favor complete todos los campos obligatorios.');
                return;
            }

            Alert.confirm(
                `Se actualizarán los datos de ${nombre} ${apellidos}. ¿Desea continuar?`,
                () => {
                    document.getElementById('formEditar').submit();
                },
                'question'
            );
        }

    </script>
}