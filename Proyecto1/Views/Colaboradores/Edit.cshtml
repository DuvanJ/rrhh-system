@model Proyecto1.Models.Colaborador

<h2>Editar Colaborador</h2>

<form method="post">

    <input type="hidden" asp-for="IdColaborador" />

    <div class="mb-3">
        <label>Cédula</label>
        <input asp-for="Cedula" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Apellidos</label>
        <input asp-for="Apellidos" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Puesto</label>
        <input asp-for="Puesto" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Departamento</label>
        <input asp-for="Departamento" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Fecha Ingreso</label>
        <input asp-for="FechaIngreso" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Salario Base</label>
        <input asp-for="SalarioBase" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Correo</label>
        <input asp-for="Correo" class="form-control" />
    </div>

    <button class="btn btn-warning">Actualizar</button>
    <a href="/Colaboradores" class="btn btn-secondary">Cancelar</a>
</form>

