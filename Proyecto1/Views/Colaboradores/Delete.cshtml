@model Proyecto1.Models.Colaborador

@{
    ViewData["Title"] = "Eliminar Colaborador";
}

<h2>Eliminar Colaborador</h2>

<div class="alert alert-danger">
    ¿Está seguro que desea eliminar este colaborador?
</div>

<form asp-action="DeleteConfirmed" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="IdColaborador" />

    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre @Model.Apellidos</dd>

        <dt class="col-sm-3">Correo</dt>
        <dd class="col-sm-9">@Model.Correo</dd>

        <dt class="col-sm-3">Puesto</dt>
        <dd class="col-sm-9">@Model.Puesto</dd>
    </dl>

    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
