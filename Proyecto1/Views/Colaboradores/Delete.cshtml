@model Proyecto1.Models.Colaborador

<h2>Eliminar Colaborador</h2>

<p>¿Seguro que desea eliminar este registro?</p>

<table class="table table-bordered">
    <tr><th>Cédula</th><td>@Model.Cedula</td></tr>
    <tr><th>Nombre</th><td>@Model.Nombre</td></tr>
    <tr><th>Apellidos</th><td>@Model.Apellidos</td></tr>
</table>

<form method="post" asp-action="DeleteConfirmed">
    <input type="hidden" asp-for="IdColaborador" />
    <button class="btn btn-danger">Eliminar</button>
    <a href="/Colaboradores" class="btn btn-secondary">Cancelar</a>
</form>

