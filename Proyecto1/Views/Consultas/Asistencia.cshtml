@model List<Proyecto1.Models.AsistenciaReporteVM>

@{
    ViewData["Title"] = "Consulta de Asistencia";
    var colaboradores = Model.Select(x => x.NombreColaborador).Distinct().OrderBy(c => c).ToList();
    var anios = Model.Select(x => x.Fecha.Year).Distinct().OrderByDescending(a => a).ToList();

    var presentes = Model.Count(x => x.Estado == "Presente");
    var tardanzas = Model.Count(x => x.Estado == "Tardanza");
    var faltas = Model.Count(x => x.Estado == "Falta");
}

@* ================================================
   HEADER
   ================================================ *@
<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-calendar-check"></i>Consulta de Asistencia
    </h3>
    <a asp-controller="Consultas" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>Volver
    </a>
</div>

@* ================================================
   KPI CARDS
   ================================================ *@
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total registros</div>
                <div class="kpi-value">@Model.Count</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-calendar-check"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Presentes</div>
                <div class="kpi-value" style="color:var(--green)">@presentes</div>
            </div>
            <div class="kpi-icon green">
                <i class="bi bi-check-circle-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Tardanzas</div>
                <div class="kpi-value" style="color:var(--amber)">@tardanzas</div>
            </div>
            <div class="kpi-icon amber">
                <i class="bi bi-clock-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Faltas</div>
                <div class="kpi-value" style="color:var(--red)">@faltas</div>
            </div>
            <div class="kpi-icon red">
                <i class="bi bi-x-circle-fill"></i>
            </div>
        </div>
    </div>

</div>

@* ================================================
   FILTROS
   ================================================ *@
<div class="filter-card mb-4">
    <div class="filter-row flex-wrap">

        <div class="filter-group" style="max-width:240px;">
            <span class="filter-label">Buscar</span>
            <input type="text"
                   id="inputBuscar"
                   class="form-control"
                   placeholder="Nombre, fecha..." />
        </div>

        <div class="filter-group" style="max-width:220px;">
            <span class="filter-label">Colaborador</span>
            <select id="filtroColaborador" class="form-select">
                <option value="">Todos</option>
                @foreach (var c in colaboradores)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>

        <div class="filter-group" style="max-width:130px;">
            <span class="filter-label">Año</span>
            <select id="filtroAnio" class="form-select">
                <option value="">Todos</option>
                @foreach (var a in anios)
                {
                    <option value="@a">@a</option>
                }
            </select>
        </div>

        <div class="filter-group" style="max-width:160px;">
            <span class="filter-label">Estado</span>
            <select id="filtroEstado" class="form-select">
                <option value="">Todos</option>
                <option value="Presente">Presente</option>
                <option value="Tardanza">Tardanza</option>
                <option value="Falta">Falta</option>
            </select>
        </div>

        <div class="filter-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="limpiarFiltros()">
                <i class="bi bi-x-circle"></i>Limpiar
            </button>
        </div>

    </div>
</div>

@* Contador *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted" style="font-size:0.82rem;">
        Mostrando <strong id="contadorVisible">@Model.Count</strong>
        de @Model.Count registros
    </span>
    <a asp-controller="Consultas" asp-action="AuditoriaAsistencia"
       class="btn btn-outline-primary">
        <i class="bi bi-shield-check"></i>Ver auditoria de ajustes
    </a>
</div>

@* ================================================
   TABLA
   ================================================ *@
<div class="card">
    <div class="card-header">
        <span class="card-header-title">
            <i class="bi bi-table"></i>Listado de asistencia
        </span>
        <span class="badge badge-info" id="badgeTotal">@Model.Count registros</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaAsistencia" class="tabla-sistema w-100">
                <thead>
                    <tr>
                        <th>Colaborador</th>
                        <th class="text-center">Fecha</th>
                        <th class="text-center">Entrada</th>
                        <th class="text-center">Salida</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var iniciales = item.NombreColaborador?
                            .Split(' ')
                            .Where(s => !string.IsNullOrEmpty(s))
                            .Take(2)
                            .Select(s => s[0].ToString())
                            .Aggregate("", (acc, c) => acc + c)
                            .ToUpper() ?? "??";

                            string badgeClass = item.Estado switch
                            {
                                "Presente" => "bg-success",
                                "Tardanza" => "bg-warning",
                                _ => "bg-danger"
                            };

                            string avatarColor = item.Estado switch
                            {
                                "Presente" => "green",
                                "Tardanza" => "amber",
                                _ => "red"
                            };

                            <tr data-colaborador="@item.NombreColaborador"
                                data-anio="@item.Fecha.Year"
                                data-estado="@item.Estado">
                                <td>
                                    <div class="table-avatar">
                                        <div class="avatar-circle avatar-@avatarColor">
                                            @iniciales
                                        </div>
                                        <div class="avatar-name">@item.NombreColaborador</div>
                                    </div>
                                </td>
                                <td class="text-center td-muted">
                                    @item.Fecha.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center td-mono"
                                    style="color:var(--green)">
                                    @(item.HoraEntrada?.ToString(@"hh\:mm") ?? "—")
                                </td>
                                <td class="text-center td-mono">
                                    @(item.HoraSalida?.ToString(@"hh\:mm") ?? "—")
                                </td>
                                <td class="text-center">
                                    <span class="badge @badgeClass badge-dot">
                                        @item.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="table-empty">
                                    <i class="bi bi-calendar-x"></i>
                                    <p>No hay registros de asistencia</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        var inputBuscar       = document.getElementById('inputBuscar');
        var filtroColaborador = document.getElementById('filtroColaborador');
        var filtroAnio        = document.getElementById('filtroAnio');
        var filtroEstado      = document.getElementById('filtroEstado');
        var filas             = document.querySelectorAll('#tablaAsistencia tbody tr');
        var contadorVisible   = document.getElementById('contadorVisible');
        var badgeTotal        = document.getElementById('badgeTotal');

        function filtrarTabla() {
            var texto       = inputBuscar.value.toLowerCase();
            var colaborador = filtroColaborador.value;
            var anio        = filtroAnio.value;
            var estado      = filtroEstado.value;
            var count       = 0;

            filas.forEach(function (fila) {
                var contenido   = fila.innerText.toLowerCase();
                var filaColab   = fila.getAttribute('data-colaborador');
                var filaAnio    = fila.getAttribute('data-anio');
                var filaEstado  = fila.getAttribute('data-estado');

                var ok = contenido.includes(texto)                      &&
                         (colaborador === '' || filaColab  === colaborador) &&
                         (anio        === '' || filaAnio   === anio)        &&
                         (estado      === '' || filaEstado === estado);

                fila.style.display = ok ? '' : 'none';
                if (ok) count++;
            });

            contadorVisible.textContent = count;
            badgeTotal.textContent      = count + ' registros';
        }

        function limpiarFiltros() {
            inputBuscar.value       = '';
            filtroColaborador.value = '';
            filtroAnio.value        = '';
            filtroEstado.value      = '';
            filtrarTabla();
        }

        inputBuscar.addEventListener('keyup', filtrarTabla);
        filtroColaborador.addEventListener('change', filtrarTabla);
        filtroAnio.addEventListener('change', filtrarTabla);
        filtroEstado.addEventListener('change', filtrarTabla);

    </script>
}