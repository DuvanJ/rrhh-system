@model List<Proyecto1.Models.ConsultaPlanillaVM>

@{
    ViewData["Title"] = "Consulta de Planillas";
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("es-ES");

    var totalBruto = Model.Sum(x => x.SalarioBruto);
    var totalNeto = Model.Sum(x => x.SalarioNeto);
    var conAlertas = Model.Count(x => x.AlertaDiasIncompletos == true);
    var periodos = Model.Select(x => $"{x.Mes}/{x.Año}").Distinct().Count();
}

@* ================================================
   HEADER
   ================================================ *@
<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-receipt-cutoff"></i>Consulta de Planillas
    </h3>
    <a asp-controller="Consultas" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>Volver
    </a>
</div>

@* ================================================
   KPI CARDS
   ================================================ *@
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total registros</div>
                <div class="kpi-value">@Model.Count</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total bruto</div>
                <div class="kpi-value" style="font-size:1.0rem;color:var(--blue)">
                    ₡ @totalBruto.ToString("N2")
                </div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-cash-stack"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total neto</div>
                <div class="kpi-value" style="font-size:1.0rem;color:var(--green)">
                    ₡ @totalNeto.ToString("N2")
                </div>
            </div>
            <div class="kpi-icon green">
                <i class="bi bi-currency-dollar"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Con alertas</div>
                <div class="kpi-value" style="color:var(--red)">@conAlertas</div>
            </div>
            <div class="kpi-icon red">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
        </div>
    </div>

</div>

@* ================================================
   FILTROS
   ================================================ *@
<div class="filter-card mb-4">
    <div class="filter-row flex-wrap">

        <div class="filter-group" style="max-width:240px;">
            <span class="filter-label">Buscar colaborador</span>
            <input type="text"
                   id="inputBuscar"
                   class="form-control"
                   placeholder="Nombre..." />
        </div>

        <div class="filter-group" style="max-width:110px;">
            <span class="filter-label">Mes</span>
            <input type="number"
                   id="filtroMes"
                   class="form-control"
                   placeholder="1-12"
                   min="1"
                   max="12" />
        </div>

        <div class="filter-group" style="max-width:120px;">
            <span class="filter-label">Año</span>
            <input type="number"
                   id="filtroAnio"
                   class="form-control"
                   placeholder="@DateTime.Now.Year" />
        </div>

        <div class="filter-group" style="max-width:160px;">
            <span class="filter-label">Alertas</span>
            <select id="filtroAlerta" class="form-select">
                <option value="">Todas</option>
                <option value="true">Con alerta</option>
                <option value="false">Sin alerta</option>
            </select>
        </div>

        <div class="filter-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="limpiarFiltros()">
                <i class="bi bi-x-circle"></i>Limpiar
            </button>
        </div>

    </div>
</div>

@* Contador *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted" style="font-size:0.82rem;">
        Mostrando <strong id="contadorVisible">@Model.Count</strong>
        de @Model.Count registros
    </span>
</div>

@* ================================================
   TABLA
   ================================================ *@
<div class="card">
    <div class="card-header">
        <span class="card-header-title">
            <i class="bi bi-table"></i>Detalle de planillas
        </span>
        <span class="badge badge-info" id="badgeTotal">@Model.Count registros</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaPlanillas" class="tabla-sistema w-100">
                <thead>
                    <tr>
                        <th>Colaborador</th>
                        <th class="text-center">Periodo</th>
                        <th class="text-end">S. Bruto</th>
                        <th class="text-end">S. Neto</th>
                        <th class="text-end">Deducciones</th>
                        <th class="text-center">Dias lab.</th>
                        <th class="text-center">Vac.</th>
                        <th class="text-center">Incap.</th>
                        <th class="text-center">Con goce</th>
                        <th class="text-center">Sin goce</th>
                        <th class="text-center">Alerta</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model.OrderByDescending(x => x.Año)
                        .ThenByDescending(x => x.Mes))
                        {
                            var iniciales = item.NombreColaborador?
                            .Split(' ')
                            .Where(s => !string.IsNullOrEmpty(s))
                            .Take(2)
                            .Select(s => s[0].ToString())
                            .Aggregate("", (acc, c) => acc + c)
                            .ToUpper() ?? "??";

                            var colores = new[] { "blue", "green", "amber", "slate" };
                            var color = colores[Math.Abs((item.NombreColaborador ?? "").GetHashCode()) % colores.Length];

                            <tr data-buscar="@item.NombreColaborador"
                                data-mes="@item.Mes"
                                data-anio="@item.Año"
                                data-alerta="@(item.AlertaDiasIncompletos == true ? "true" : "false")">
                                <td>
                                    <div class="table-avatar">
                                        <div class="avatar-circle avatar-@color">
                                            @iniciales
                                        </div>
                                        <div class="avatar-name">@item.NombreColaborador</div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-secondary td-mono">
                                        @cultura.DateTimeFormat.GetAbbreviatedMonthName(item.Mes) @item.Año
                                    </span>
                                </td>
                                <td class="text-end td-mono"
                                    style="color:var(--blue);font-weight:600;">
                                    ₡ @item.SalarioBruto.ToString("N2")
                                </td>
                                <td class="text-end td-mono"
                                    style="color:var(--green);font-weight:700;">
                                    ₡ @item.SalarioNeto.ToString("N2")
                                </td>
                                <td class="text-end td-mono"
                                    style="color:var(--red);font-weight:600;">
                                    ₡ @item.Deducciones.ToString("N2")
                                </td>
                                <td class="text-center td-mono">@item.DiasLaborados</td>
                                <td class="text-center td-mono">
                                    @(item.DiasVacaciones > 0
                                                                ? item.DiasVacaciones.ToString()
                                                                : "—")
                                                                  </td>
                                                                  <td class="text-center td-mono">
                                    @(item.DiasIncapacidad > 0
                                                                ? item.DiasIncapacidad.ToString()
                                                                : "—")
                                                                  </td>
                                                                  <td class="text-center td-mono">
                                    @(item.TotalDiasConGoce > 0
                                                                ? item.TotalDiasConGoce.ToString()
                                                                : "—")
                                                                  </td>
                                                                  <td class="text-center td-mono">
                                    @(item.TotalDiasSinGoce > 0
                                                                ? item.TotalDiasSinGoce.ToString()
                                                                : "—")
                        </td>
                        <td class="text-center">
                            @if (item.AlertaDiasIncompletos == true)
                                    {
                                        <span class="badge bg-danger badge-dot">
                                            <i class="bi bi-exclamation-triangle me-1"></i>Incompleto
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="td-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11">
                                <div class="table-empty">
                                    <i class="bi bi-receipt-cutoff"></i>
                                    <p>No hay registros de planillas</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        var inputBuscar    = document.getElementById('inputBuscar');
        var filtroMes      = document.getElementById('filtroMes');
        var filtroAnio     = document.getElementById('filtroAnio');
        var filtroAlerta   = document.getElementById('filtroAlerta');
        var filas          = document.querySelectorAll('#tablaPlanillas tbody tr');
        var contadorVisible = document.getElementById('contadorVisible');
        var badgeTotal     = document.getElementById('badgeTotal');

        function filtrarTabla() {
            var texto  = inputBuscar.value.toLowerCase();
            var mes    = filtroMes.value;
            var anio   = filtroAnio.value;
            var alerta = filtroAlerta.value;
            var count  = 0;

            filas.forEach(function (fila) {
                var buscar     = fila.getAttribute('data-buscar').toLowerCase();
                var filaMes    = fila.getAttribute('data-mes');
                var filaAnio   = fila.getAttribute('data-anio');
                var filaAlerta = fila.getAttribute('data-alerta');

                var ok = buscar.includes(texto)                  &&
                         (mes    === '' || filaMes    === mes)   &&
                         (anio   === '' || filaAnio   === anio)  &&
                         (alerta === '' || filaAlerta === alerta);

                fila.style.display = ok ? '' : 'none';
                if (ok) count++;
            });

            contadorVisible.textContent = count;
            badgeTotal.textContent      = count + ' registros';
        }

        function limpiarFiltros() {
            inputBuscar.value  = '';
            filtroMes.value    = '';
            filtroAnio.value   = '';
            filtroAlerta.value = '';
            filtrarTabla();
        }

        inputBuscar.addEventListener('keyup', filtrarTabla);
        filtroMes.addEventListener('input', filtrarTabla);
        filtroAnio.addEventListener('input', filtrarTabla);
        filtroAlerta.addEventListener('change', filtrarTabla);

    </script>
}