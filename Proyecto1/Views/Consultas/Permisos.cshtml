@model List<Proyecto1.Models.PermisoAdminVM>

@{
    ViewData["Title"] = "Consulta de Permisos";

    var pendientes = Model.Count(x => x.Estado == "Pendiente");
    var aprobados = Model.Count(x => x.Estado == "Aprobado");
    var rechazados = Model.Count(x => x.Estado == "Rechazado");
    var totalDias = Model.Sum(x => (x.FechaFin - x.FechaInicio).Days + 1);
}

@* ================================================
   HEADER
   ================================================ *@
<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-calendar-check"></i>Consulta de Permisos
    </h3>
    <a asp-controller="Consultas" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>Volver
    </a>
</div>

@* ================================================
   KPI CARDS
   ================================================ *@
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total permisos</div>
                <div class="kpi-value">@Model.Count</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-calendar-event"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Pendientes</div>
                <div class="kpi-value" style="color:var(--amber)">@pendientes</div>
            </div>
            <div class="kpi-icon amber">
                <i class="bi bi-clock-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Aprobados</div>
                <div class="kpi-value" style="color:var(--green)">@aprobados</div>
            </div>
            <div class="kpi-icon green">
                <i class="bi bi-check-circle-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total dias</div>
                <div class="kpi-value" style="color:var(--blue)">@totalDias</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-calendar-range"></i>
            </div>
        </div>
    </div>

</div>

@* ================================================
   FILTROS
   ================================================ *@
<div class="filter-card mb-4">
    <div class="filter-row flex-wrap">

        <div class="filter-group" style="max-width:240px;">
            <span class="filter-label">Buscar</span>
            <input type="text"
                   id="inputBuscar"
                   class="form-control"
                   placeholder="Nombre, tipo permiso..." />
        </div>

        <div class="filter-group" style="max-width:160px;">
            <span class="filter-label">Estado</span>
            <select id="filtroEstado" class="form-select">
                <option value="">Todos</option>
                <option value="Pendiente">Pendiente</option>
                <option value="Aprobado">Aprobado</option>
                <option value="Rechazado">Rechazado</option>
            </select>
        </div>

        <div class="filter-group" style="max-width:160px;">
            <span class="filter-label">Fecha inicio desde</span>
            <input type="date" id="filtroFechaInicio" class="form-control" />
        </div>

        <div class="filter-group" style="max-width:160px;">
            <span class="filter-label">Fecha inicio hasta</span>
            <input type="date" id="filtroFechaFin" class="form-control" />
        </div>

        <div class="filter-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="limpiarFiltros()">
                <i class="bi bi-x-circle"></i>Limpiar
            </button>
        </div>

    </div>
</div>

@* Contador *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted" style="font-size:0.82rem;">
        Mostrando <strong id="contadorVisible">@Model.Count</strong>
        de @Model.Count registros
    </span>
</div>

@* ================================================
   TABLA
   ================================================ *@
<div class="card">
    <div class="card-header">
        <span class="card-header-title">
            <i class="bi bi-table"></i>Listado de permisos
        </span>
        <span class="badge badge-info" id="badgeTotal">@Model.Count registros</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaPermisos" class="tabla-sistema w-100">
                <thead>
                    <tr>
                        <th>Colaborador</th>
                        <th>Tipo permiso</th>
                        <th class="text-center">Solicitud</th>
                        <th class="text-center">Inicio</th>
                        <th class="text-center">Fin</th>
                        <th class="text-center">Dias</th>
                        <th class="text-center">Estado</th>
                        <th>Observaciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model.OrderByDescending(x => x.FechaSolicitud))
                        {
                            var iniciales = item.NombreColaborador?
                            .Split(' ')
                            .Where(s => !string.IsNullOrEmpty(s))
                            .Take(2)
                            .Select(s => s[0].ToString())
                            .Aggregate("", (acc, c) => acc + c)
                            .ToUpper() ?? "??";

                            string badgeClass = item.Estado switch
                            {
                                "Aprobado" => "bg-success",
                                "Pendiente" => "bg-warning",
                                _ => "bg-danger"
                            };

                            string avatarColor = item.Estado switch
                            {
                                "Aprobado" => "green",
                                "Pendiente" => "amber",
                                _ => "red"
                            };

                            var dias = (item.FechaFin - item.FechaInicio).Days + 1;
                            var fechaData = item.FechaInicio.ToString("yyyy-MM-dd");

                            <tr data-buscar="@item.NombreColaborador @item.TipoPermiso"
                                data-estado="@item.Estado"
                                data-fecha="@fechaData">
                                <td>
                                    <div class="table-avatar">
                                        <div class="avatar-circle avatar-@avatarColor">
                                            @iniciales
                                        </div>
                                        <div class="avatar-name">@item.NombreColaborador</div>
                                    </div>
                                </td>
                                <td>@item.TipoPermiso</td>
                                <td class="text-center td-muted">
                                    @item.FechaSolicitud.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center td-muted">
                                    @item.FechaInicio.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center td-muted">
                                    @item.FechaFin.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center">
                                    <span class="td-mono"
                                          style="font-weight:700;color:var(--blue)">
                                        @dias
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @badgeClass badge-dot">@item.Estado</span>
                                </td>
                                <td class="td-muted" style="max-width:180px;">
                                    @(string.IsNullOrEmpty(item.Observaciones)
                                                                ? "—"
                                                                : item.Observaciones.Length > 50
                                                                ? item.Observaciones.Substring(0, 50) + "..."
                                                                : item.Observaciones)
                        </td>
                    </tr>
                                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="table-empty">
                                    <i class="bi bi-calendar-event"></i>
                                    <p>No hay registros de permisos</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        var inputBuscar       = document.getElementById('inputBuscar');
        var filtroEstado      = document.getElementById('filtroEstado');
        var filtroFechaInicio = document.getElementById('filtroFechaInicio');
        var filtroFechaFin    = document.getElementById('filtroFechaFin');
        var filas             = document.querySelectorAll('#tablaPermisos tbody tr');
        var contadorVisible   = document.getElementById('contadorVisible');
        var badgeTotal        = document.getElementById('badgeTotal');

        function filtrarTabla() {
            var texto  = inputBuscar.value.toLowerCase();
            var estado = filtroEstado.value;
            var desde  = filtroFechaInicio.value;
            var hasta  = filtroFechaFin.value;
            var count  = 0;

            filas.forEach(function (fila) {
                var contenido  = fila.getAttribute('data-buscar').toLowerCase();
                var filaEstado = fila.getAttribute('data-estado');
                var filaFecha  = fila.getAttribute('data-fecha');

                var coincideFecha = true;
                if (desde) coincideFecha = filaFecha >= desde;
                if (hasta) coincideFecha = coincideFecha && filaFecha <= hasta;

                var ok = contenido.includes(texto)                &&
                         (estado === '' || filaEstado === estado) &&
                         coincideFecha;

                fila.style.display = ok ? '' : 'none';
                if (ok) count++;
            });

            contadorVisible.textContent = count;
            badgeTotal.textContent      = count + ' registros';
        }

        function limpiarFiltros() {
            inputBuscar.value       = '';
            filtroEstado.value      = '';
            filtroFechaInicio.value = '';
            filtroFechaFin.value    = '';
            filtrarTabla();
        }

        inputBuscar.addEventListener('keyup', filtrarTabla);
        filtroEstado.addEventListener('change', filtrarTabla);
        filtroFechaInicio.addEventListener('change', filtrarTabla);
        filtroFechaFin.addEventListener('change', filtrarTabla);

    </script>
}