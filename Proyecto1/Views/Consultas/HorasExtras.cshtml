@model List<Proyecto1.Models.HoraExtraAdminVM>

@{
    ViewData["Title"] = "Consulta de Horas Extras";
    var colaboradores = Model.Select(x => x.NombreColaborador).Distinct().OrderBy(c => c).ToList();
    var anios = Model.Select(x => x.Fecha.Year).Distinct().OrderByDescending(a => a).ToList();

    var totalHoras = Model.Sum(x => x.CantidadHoras);
    var aprobados = Model.Count(x => x.Estado == "Aprobada");
    var pendientes = Model.Count(x => x.Estado == "Pendiente");
    var rechazados = Model.Count(x => x.Estado == "Rechazada");
}

@* ================================================
   HEADER
   ================================================ *@
<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-clock-history"></i>Consulta de Horas Extras
    </h3>
    <a asp-controller="Consultas" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>Volver
    </a>
</div>

@* ================================================
   KPI CARDS
   ================================================ *@
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total registros</div>
                <div class="kpi-value">@Model.Count</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-list-check"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total horas extras</div>
                <div class="kpi-value" style="color:var(--blue)">@totalHoras</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-clock-history"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Aprobadas</div>
                <div class="kpi-value" style="color:var(--green)">@aprobados</div>
            </div>
            <div class="kpi-icon green">
                <i class="bi bi-check-circle-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Pendientes</div>
                <div class="kpi-value" style="color:var(--amber)">@pendientes</div>
            </div>
            <div class="kpi-icon amber">
                <i class="bi bi-clock-fill"></i>
            </div>
        </div>
    </div>

</div>

@* ================================================
   FILTROS
   ================================================ *@
<div class="filter-card mb-4">
    <div class="filter-row flex-wrap">

        <div class="filter-group" style="max-width:240px;">
            <span class="filter-label">Buscar</span>
            <input type="text"
                   id="inputBuscar"
                   class="form-control"
                   placeholder="Nombre, motivo..." />
        </div>

        <div class="filter-group" style="max-width:220px;">
            <span class="filter-label">Colaborador</span>
            <select id="filtroColaborador" class="form-select">
                <option value="">Todos</option>
                @foreach (var c in colaboradores)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>

        <div class="filter-group" style="max-width:130px;">
            <span class="filter-label">Año</span>
            <select id="filtroAnio" class="form-select">
                <option value="">Todos</option>
                @foreach (var a in anios)
                {
                    <option value="@a">@a</option>
                }
            </select>
        </div>

        <div class="filter-group" style="max-width:160px;">
            <span class="filter-label">Estado</span>
            <select id="filtroEstado" class="form-select">
                <option value="">Todos</option>
                <option value="Pendiente">Pendiente</option>
                <option value="Aprobada">Aprobada</option>
                <option value="Rechazada">Rechazada</option>
            </select>
        </div>

        <div class="filter-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="limpiarFiltros()">
                <i class="bi bi-x-circle"></i>Limpiar
            </button>
        </div>

    </div>
</div>

@* Contador dinamico *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted" style="font-size:0.82rem;">
        Mostrando <strong id="contadorVisible">@Model.Count</strong>
        de @Model.Count registros
    </span>
</div>

@* ================================================
   TABLA
   ================================================ *@
<div class="card mb-4">
    <div class="card-header">
        <span class="card-header-title">
            <i class="bi bi-table"></i>Listado de horas extras
        </span>
        <span class="badge badge-info" id="badgeTotal">@Model.Count registros</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaHoras" class="tabla-sistema w-100">
                <thead>
                    <tr>
                        <th>Colaborador</th>
                        <th class="text-center">Fecha</th>
                        <th class="text-center">Horas</th>
                        <th>Motivo</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var iniciales = item.NombreColaborador?
                            .Split(' ')
                            .Where(s => !string.IsNullOrEmpty(s))
                            .Take(2)
                            .Select(s => s[0].ToString())
                            .Aggregate("", (acc, c) => acc + c)
                            .ToUpper() ?? "??";

                            string badgeClass = item.Estado switch
                            {
                                "Aprobada" => "bg-success",
                                "Pendiente" => "bg-warning",
                                _ => "bg-danger"
                            };

                            string avatarColor = item.Estado switch
                            {
                                "Aprobada" => "green",
                                "Pendiente" => "amber",
                                _ => "red"
                            };

                            <tr data-colaborador="@item.NombreColaborador"
                                data-anio="@item.Fecha.Year"
                                data-estado="@item.Estado">
                                <td>
                                    <div class="table-avatar">
                                        <div class="avatar-circle avatar-@avatarColor">
                                            @iniciales
                                        </div>
                                        <div class="avatar-name">@item.NombreColaborador</div>
                                    </div>
                                </td>
                                <td class="text-center td-muted">
                                    @item.Fecha.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center">
                                    <span class="td-mono"
                                          style="font-weight:700;color:var(--blue)">
                                        @item.CantidadHoras h
                                    </span>
                                </td>
                                <td class="td-muted" style="max-width:200px;">
                                    @(item.Motivo?.Length > 50
                                                                ? item.Motivo.Substring(0, 50) + "..."
                                                                : item.Motivo)
                        </td>
                        <td class="text-center">
                            <span class="badge @badgeClass badge-dot">@item.Estado</span>
                        </td>
                    </tr>
                                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="table-empty">
                                    <i class="bi bi-clock-history"></i>
                                    <p>No hay registros de horas extras</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ================================================
   GRAFICO
   ================================================ *@
<div class="card">
    <div class="card-header">
        <span class="card-header-title">
            <i class="bi bi-bar-chart-fill"></i>Horas extras por colaborador
        </span>
    </div>
    <div class="card-body">
        <canvas id="graficoHoras" height="80"></canvas>
    </div>
</div>

@section Scripts {
    <script>

        var inputBuscar       = document.getElementById('inputBuscar');
        var filtroColaborador = document.getElementById('filtroColaborador');
        var filtroAnio        = document.getElementById('filtroAnio');
        var filtroEstado      = document.getElementById('filtroEstado');
        var filas             = document.querySelectorAll('#tablaHoras tbody tr');
        var contadorVisible   = document.getElementById('contadorVisible');
        var badgeTotal        = document.getElementById('badgeTotal');

        function filtrarTabla() {
            var texto       = inputBuscar.value.toLowerCase();
            var colaborador = filtroColaborador.value;
            var anio        = filtroAnio.value;
            var estado      = filtroEstado.value;
            var count       = 0;

            filas.forEach(function (fila) {
                var contenido   = fila.innerText.toLowerCase();
                var filaColab   = fila.getAttribute('data-colaborador');
                var filaAnio    = fila.getAttribute('data-anio');
                var filaEstado  = fila.getAttribute('data-estado');

                var ok = contenido.includes(texto) &&
                         (colaborador === '' || filaColab  === colaborador) &&
                         (anio        === '' || filaAnio   === anio)        &&
                         (estado      === '' || filaEstado === estado);

                fila.style.display = ok ? '' : 'none';
                if (ok) count++;
            });

            contadorVisible.textContent = count;
            badgeTotal.textContent      = count + ' registros';
        }

        function limpiarFiltros() {
            inputBuscar.value       = '';
            filtroColaborador.value = '';
            filtroAnio.value        = '';
            filtroEstado.value      = '';
            filtrarTabla();
        }

        inputBuscar.addEventListener('keyup', filtrarTabla);
        filtroColaborador.addEventListener('change', filtrarTabla);
        filtroAnio.addEventListener('change', filtrarTabla);
        filtroEstado.addEventListener('change', filtrarTabla);

        // Agrupar horas por colaborador para el grafico
        var mapaHoras = {};

        @foreach (var item in Model)
        {
                    var nombreSeguro = (item.NombreColaborador ?? "").Replace("'", "\\'");
                    <text>
                    mapaHoras['@nombreSeguro'] = (mapaHoras['@nombreSeguro'] || 0) + @item.CantidadHoras;
                    </text>
        }

        var nombresGrafico = Object.keys(mapaHoras);
        var horasGrafico   = Object.values(mapaHoras);

        new Chart(document.getElementById('graficoHoras'), {
            type: 'bar',
            data: {
                labels: nombresGrafico,
                datasets: [{
                    label: 'Horas extras',
                    data: horasGrafico,
                    backgroundColor: '#2563eb',
                    borderRadius: 6,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function (ctx) {
                                return ' ' + ctx.raw + ' horas en total';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9' },
                        ticks: { color: '#94a3b8', font: { size: 11 } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: '#64748b', font: { size: 11 } }
                    }
                }
            }
        });

    </script>
}