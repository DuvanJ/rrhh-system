<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Proyecto1</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>

    @{
        var rol = Context.Session.GetString("Perfil");
    }

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">

            <a class="navbar-brand" href="/Home/Index">RRHH System</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarNav" aria-controls="navbarNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav me-auto">

                    @* ----------------- ADMINISTRADOR ---------------- *@
                    @if (rol == "Administrador")
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Usuarios">Usuarios</a>
                        </li>
                    }

                    @* ----------------- ADMINISTRADOR / RRHH ---------------- *@
                    @if (rol == "Administrador" || rol == "RRHH")
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Colaboradores">Colaboradores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Asistencia">Asistencia</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Permisos">Permisos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Vacaciones">Vacaciones</a>
                        </li>
                    }

                    @* ----------------- COLABORADOR ---------------- *@
                    @if (rol == "Colaborador")
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Perfil">Mi Información</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/MiAsistencia">Mi asistencia</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/MisPermisos">Mis permisos</a>
                        </li>
                    }

                </ul>

                <ul class="navbar-nav ms-auto">
                    @if (!string.IsNullOrEmpty(rol))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning">@rol</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" href="/Login/Logout">Salir</a>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
