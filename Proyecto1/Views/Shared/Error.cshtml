@model ErrorViewModel
@{
    ViewData["Title"] = "Error del Sistema";
}

<div style="min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
    <div style="text-align: center; max-width: 600px;">

        <!-- Icono grande -->
        <div style="margin-bottom: 24px;">
            <i class="bi bi-exclamation-triangle"
               style="font-size: 4rem; color: var(--red); opacity: 0.8;"></i>
        </div>

        <!-- Título -->
        <h2 style="color: var(--navy); font-weight: 700; font-size: 1.8rem; margin-bottom: 8px;">
            Oops, algo salió mal
        </h2>

        <!-- Código de error -->
        <p style="color: var(--text-3); font-size: 0.95rem; margin-bottom: 20px;">
            @{
                var mensajeError = Model.StatusCode switch
                {
                    404 => "Página no encontrada",
                    403 => "Acceso denegado",
                    500 => "Error interno del servidor",
                    _ => "Error desconocido"
                };
            }
            <strong style="color: var(--red);">Error @Model.StatusCode</strong> — @mensajeError
        </p>

        <!-- Mensaje descriptivo -->
        <div style="background: #fef2f2; border-left: 4px solid var(--red); padding: 16px; border-radius: var(--radius-lg); margin-bottom: 24px;">
            <p style="color: var(--red-t); font-size: 0.9rem; margin: 0;">
                <i class="bi bi-info-circle" style="margin-right: 8px;"></i>
                @{
                    var descripcion = Model.StatusCode switch
                    {
                        404 => "La página que buscas no existe. Verifica la URL e intenta de nuevo.",
                        403 => "No tienes permiso para acceder a este recurso.",
                        500 => "El sistema encontró un error inesperado. Por favor, intenta de nuevo más tarde.",
                        _ => "Ocurrió un error. Por favor, contacta al administrador."
                    };
                }
                @descripcion
            </p>
        </div>

        <!-- Request ID si está disponible -->
        @if (Model.ShowRequestId)
        {
            <div style="background: #f8fafc; border-left: 4px solid var(--slate); padding: 12px 16px; border-radius: var(--radius-lg); margin-bottom: 24px;">
                <p style="color: var(--text-2); font-size: 0.85rem; margin: 0;">
                    <strong>ID de solicitud:</strong>
                    <code style="background: #ffffff; padding: 4px 8px; border-radius: 4px; font-family: 'Consolas', monospace; font-size: 0.8rem;">@Model.RequestId</code>
                </p>
                <p style="color: var(--text-3); font-size: 0.75rem; margin: 8px 0 0 0;">
                    Proporciona este ID al soporte técnico para investigar el problema.
                </p>
            </div>
        }

        <!-- Botones de acción -->
        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 24px;">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house"></i>Ir al Inicio
            </a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>Volver
            </a>
        </div>

        <!-- Información adicional -->
        <hr style="border: none; border-top: 1px solid var(--border); margin: 32px 0;">

        <div style="background: #f8fafc; padding: 16px; border-radius: var(--radius-lg); margin-bottom: 0;">
            <p style="color: var(--text-3); font-size: 0.78rem; margin: 0;">
                <strong style="color: var(--text-2);">¿Qué puedo hacer?</strong>
            </p>
            <ul style="text-align: left; color: var(--text-2); font-size: 0.82rem; margin: 8px 0 0 0; padding-left: 20px;">
                <li>Recarga la página e intenta de nuevo</li>
                <li>Verifica la URL ingresada</li>
                <li>Limpia la caché del navegador</li>
                <li>Contacta al soporte si el problema persiste</li>
            </ul>
        </div>

        <p style="color: var(--text-3); font-size: 0.78rem; margin-top: 20px; margin-bottom: 0;">
            Si necesitas ayuda,
            <a href="mailto:soporte@empresa.com" style="color: var(--blue); text-decoration: none; font-weight: 500;">
                contacta al soporte
            </a>
        </p>

    </div>
</div>