@model Proyecto1.Models.PlanillaDetalleColaboradorVM

@{
    ViewData["Title"] = "Detalle del Colaborador";
}

<h3 class="fw-bold mb-4">
    <i class="bi bi-person-badge"></i> Detalle del Colaborador
</h3>

<!-- ================= RESUMEN CARDS ================= -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 text-white bg-primary">
            <div class="card-body">
                <h6>Salario Base</h6>
                <h4>₡ @Model.SalarioBase.ToString("N2")</h4>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 text-white bg-success">
            <div class="card-body">
                <h6>Salario Neto</h6>
                <h4>₡ @Model.SalarioNeto.ToString("N2")</h4>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 text-white bg-warning">
            <div class="card-body">
                <h6>Deducciones</h6>
                <h4>₡ @Model.Deducciones.ToString("N2")</h4>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 text-white bg-info">
            <div class="card-body">
                <h6>Horas Extras</h6>
                <h4>@Model.HorasExtras.ToString("N2")</h4>
            </div>
        </div>
    </div>
</div>

<!-- ================= TABS ================= -->
<ul class="nav nav-tabs mb-3" id="detalleTabs" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#planilla">Planilla</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#asistencia">Asistencia</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#permisos">Permisos</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#incapacidades">Incapacidades</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#vacaciones">Vacaciones</button>
    </li>
</ul>

<div class="tab-content">

    <!-- ================= TAB PLANILLA ================= -->
    <div class="tab-pane fade show active" id="planilla">
        <table class="table table-bordered shadow-sm">
            <tr><th>Colaborador</th><td>@Model.NombreColaborador</td></tr>
            <tr><th>Días Laborados</th><td>@Model.DiasLaborados</td></tr>
            <tr><th>Horas Ordinarias</th><td>@Model.HorasOrdinarias</td></tr>
            <tr><th>Horas Extras</th><td>@Model.HorasExtras</td></tr>
            <tr><th>Monto Horas Extras</th><td>₡ @Model.MontoHorasExtras.ToString("N2")</td></tr>
            <tr class="fw-bold text-primary"><th>Salario Bruto</th><td>₡ @Model.SalarioBruto.ToString("N2")</td></tr>
            <tr class="fw-bold text-success"><th>Salario Neto</th><td>₡ @Model.SalarioNeto.ToString("N2")</td></tr>
        </table>
    </div>

    <!-- ================= TAB ASISTENCIA ================= -->
    <div class="tab-pane fade" id="asistencia">
        <table class="table table-striped table-bordered shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>Entrada</th>
                    <th>Salida</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Asistencias)
                {
                    <tr>
                        <td>@a.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@a.HoraEntrada</td>
                        <td>@a.HoraSalida</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ================= TAB PERMISOS ================= -->
    <div class="tab-pane fade" id="permisos">
        <table class="table table-striped table-bordered shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Tipo</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Observaciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Permisos)
                {
                    <tr>
                        <td>@p.TipoPermiso</td>
                        <td>@p.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@p.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td>@p.Observaciones</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ================= TAB INCAPACIDADES ================= -->
    <div class="tab-pane fade" id="incapacidades">
        <div class="alert alert-info">
            Módulo de incapacidades pendiente de implementar.
        </div>
    </div>

    <!-- ================= TAB VACACIONES ================= -->
    <div class="tab-pane fade" id="vacaciones">
        <div class="alert alert-info">
            Módulo de vacaciones pendiente de implementar.
        </div>
    </div>

</div>

<a asp-action="Detalle" asp-route-id="@Model.IdPlanilla" class="btn btn-secondary mt-3">
    <i class="bi bi-arrow-left"></i> Volver a Planilla
</a>
