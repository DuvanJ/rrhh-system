@model IEnumerable<Proyecto1.Models.PlanillaDetalleVM>

@{
    ViewData["Title"] = "Detalle de Planilla";
}

<h3 class="fw-bold mb-4">Detalle de Planilla</h3>

<table class="table table-striped table-bordered shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Colaborador</th>
            <th>Salario Base</th>
            <th>Días Trabajados</th>
            <th>Horas Ordinarias</th>
            <th>Horas Extras</th>
            <th>Monto HE</th>
            <th>Deducciones</th>
            <th>Salario Bruto</th>
            <th>Salario Neto</th>
            <th>Acciones</th> <!-- ✅ NUEVO -->
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="10" class="text-center text-muted">
                    No hay datos de planilla.
                </td>
            </tr>
        }
        else
        {
            foreach (var p in Model)
            {
                <tr>
                    <td>@p.NombreColaborador</td>

                    <td>₡ @String.Format("{0:N2}", p.SalarioBase)</td>

                    <td>@p.DiasLaborados</td>

                    <td>@String.Format("{0:N2}", p.HorasOrdinarias)</td>

                    <td>@String.Format("{0:N2}", p.HorasExtras)</td>

                    <td>₡ @String.Format("{0:N2}", p.MontoHorasExtras)</td>

                    <td>₡ @String.Format("{0:N2}", p.Deducciones)</td>

                    <td class="fw-bold text-primary">
                        ₡ @String.Format("{0:N2}", p.SalarioBruto)
                    </td>

                    <td class="fw-bold text-success">
                        ₡ @String.Format("{0:N2}", p.SalarioNeto)
                    </td>

                    <!-- ✅ BOTÓN DETALLE COLABORADOR -->
                    <td>
                        <a asp-action="DetalleColaborador"
                           asp-route-idPlanilla="@p.IdPlanilla"
                           asp-route-idColaborador="@p.IdColaborador"
                           class="btn btn-sm btn-primary">
                            <i class="bi bi-person-lines-fill"></i> Detalle
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>

    <!-- ================= TOTALES ================= -->
    <tfoot class="table-secondary fw-bold">
        <tr>
            <td>TOTALES</td>
            <td>₡ @Model.Sum(x => x.SalarioBase).ToString("N2")</td>
            <td>@Model.Sum(x => x.DiasLaborados)</td>
            <td>@Model.Sum(x => x.HorasOrdinarias).ToString("N2")</td>
            <td>@Model.Sum(x => x.HorasExtras).ToString("N2")</td>
            <td>₡ @Model.Sum(x => x.MontoHorasExtras).ToString("N2")</td>
            <td>₡ @Model.Sum(x => x.Deducciones).ToString("N2")</td>
            <td>₡ @Model.Sum(x => x.SalarioBruto).ToString("N2")</td>
            <td>₡ @Model.Sum(x => x.SalarioNeto).ToString("N2")</td>
            <td></td>
        </tr>
    </tfoot>
</table>

<a asp-action="Index" class="btn btn-secondary mt-3">
    <i class="bi bi-arrow-left"></i> Volver
</a>
