@model IEnumerable<Proyecto1.Models.PlanillaDetalleVM>

@{
    ViewData["Title"] = "Detalle de Planilla";
    var lista = Model.ToList();
}

@* ================================================
   HEADER
   ================================================ *@
<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-receipt"></i>Detalle de Planilla
    </h3>
    <div class="d-flex gap-2">
        <a asp-action="ExportarPdf"
           asp-route-idPlanilla="@ViewBag.IdPlanilla"
           class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf"></i>Descargar PDF
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>Volver
        </a>
    </div>
</div>

@* ================================================
   KPI CARDS
   ================================================ *@
<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Salario base total</div>
                <div class="kpi-value" style="font-size:1.2rem;">
                    ₡ @lista.Sum(x => x.SalarioBase).ToString("N2")
                </div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-cash-stack"></i>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Salario neto total</div>
                <div class="kpi-value" style="font-size:1.2rem;color:var(--green)">
                    ₡ @lista.Sum(x => x.SalarioNeto).ToString("N2")
                </div>
            </div>
            <div class="kpi-icon green">
                <i class="bi bi-currency-dollar"></i>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total deducciones</div>
                <div class="kpi-value" style="font-size:1.2rem;color:var(--red)">
                    ₡ @lista.Sum(x => x.Deducciones).ToString("N2")
                </div>
            </div>
            <div class="kpi-icon red">
                <i class="bi bi-dash-circle-fill"></i>
            </div>
        </div>
    </div>

</div>

@* ================================================
   TABLA
   ================================================ *@
<div class="card">
    <div class="card-header">
        <span class="card-header-title">
            <i class="bi bi-table"></i>Detalle por colaborador
        </span>
        <span class="badge badge-info">@lista.Count colaboradores</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaDetalle" class="tabla-sistema w-100">
                <thead>
                    <tr>
                        <th>Colaborador</th>
                        <th class="text-end">Salario base</th>
                        <th class="text-center">Días</th>
                        <th class="text-end">H. Ord.</th>
                        <th class="text-end">H. Extra</th>
                        <th class="text-end">H. Feriado</th>
                        <th class="text-end">Monto HE</th>
                        <th class="text-end">Monto Feriado</th>
                        <th class="text-end">Deducciones</th>
                        <th class="text-end">S. Bruto</th>
                        <th class="text-end">S. Neto</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!lista.Any())
                    {
                        <tr>
                            <td colspan="12">
                                <div class="table-empty">
                                    <i class="bi bi-receipt"></i>
                                    <p>No hay datos de planilla</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var p in lista)
                        {
                            var iniciales = p.NombreColaborador?
                            .Split(' ')
                            .Where(s => !string.IsNullOrEmpty(s))
                            .Take(2)
                            .Select(s => s[0].ToString())
                            .Aggregate("", (acc, c) => acc + c)
                            .ToUpper() ?? "??";

                            <tr>
                                <td>
                                    <div class="table-avatar">
                                        <div class="avatar-circle avatar-blue">
                                            @iniciales
                                        </div>
                                        <div class="avatar-name">
                                            @p.NombreColaborador
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end td-mono">
                                    ₡ @p.SalarioBase.ToString("N2")
                                </td>
                                <td class="text-center td-mono">
                                    @p.DiasLaborados
                                </td>
                                <td class="text-end td-mono">
                                    @p.HorasOrdinarias.ToString("N2")
                                </td>
                                <td class="text-end td-mono"
                                    style="color:var(--blue);font-weight:600;">
                                    @p.HorasExtras.ToString("N2")
                                </td>
                                <td class="text-end td-mono"
                                    style="color:var(--amber);font-weight:600;">
                                    @p.HorasFeriado.GetValueOrDefault().ToString("N2")
                                </td>
                                <td class="text-end td-mono">
                                    ₡ @p.MontoHorasExtras.ToString("N2")
                                </td>
                                <td class="text-end td-mono"
                                    style="color:var(--amber);font-weight:600;">
                                    ₡ @p.MontoFeriado.GetValueOrDefault().ToString("N2")
                                </td>
                                <td class="text-end td-mono"
                                    style="color:var(--red);font-weight:600;">
                                    ₡ @p.Deducciones.ToString("N2")
                                </td>
                                <td class="text-end td-mono"
                                    style="font-weight:700;color:var(--blue)">
                                    ₡ @p.SalarioBruto.ToString("N2")
                                </td>
                                <td class="text-end td-mono"
                                    style="font-weight:700;color:var(--green)">
                                    ₡ @p.SalarioNeto.ToString("N2")
                                </td>
                                <td>
                                    <div class="td-actions">
                                        <a asp-action="DetalleColaborador"
                                           asp-route-idPlanilla="@p.IdPlanilla"
                                           asp-route-idColaborador="@p.IdColaborador"
                                           class="btn btn-primary btn-sm">
                                            <i class="bi bi-person-lines-fill"></i>Detalle
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

                @* Fila de totales *@
                @if (lista.Any())
                {
                    <tfoot>
                        <tr style="background:var(--slate-l);border-top:2px solid var(--border);">
                            <td style="font-weight:700;color:var(--navy);padding:12px 14px;">
                                <i class="bi bi-calculator me-1"
                                   style="color:var(--blue)"></i>TOTALES
                            </td>
                            <td class="text-end td-mono" style="font-weight:700;">
                                ₡ @lista.Sum(x => x.SalarioBase).ToString("N2")
                            </td>
                            <td class="text-center td-mono" style="font-weight:700;">
                                @lista.Sum(x => x.DiasLaborados)
                            </td>
                            <td class="text-end td-mono" style="font-weight:700;">
                                @lista.Sum(x => x.HorasOrdinarias).ToString("N2")
                            </td>
                            <td class="text-end td-mono"
                                style="font-weight:700;color:var(--blue)">
                                @lista.Sum(x => x.HorasExtras).ToString("N2")
                            </td>
                            <td class="text-end td-mono"
                                style="font-weight:700;color:var(--amber)">
                                @lista.Sum(x => x.HorasFeriado ?? 0).ToString("N2")
                            </td>
                            <td class="text-end td-mono" style="font-weight:700;">
                                ₡ @lista.Sum(x => x.MontoHorasExtras).ToString("N2")
                            </td>
                            <td class="text-end td-mono"
                                style="font-weight:700;color:var(--amber)">
                                ₡ @lista.Sum(x => x.MontoFeriado ?? 0).ToString("N2")
                            </td>
                            <td class="text-end td-mono"
                                style="font-weight:700;color:var(--red)">
                                ₡ @lista.Sum(x => x.Deducciones).ToString("N2")
                            </td>
                            <td class="text-end td-mono"
                                style="font-weight:700;color:var(--blue)">
                                ₡ @lista.Sum(x => x.SalarioBruto).ToString("N2")
                            </td>
                            <td class="text-end td-mono"
                                style="font-weight:700;color:var(--green);font-size:1rem;">
                                ₡ @lista.Sum(x => x.SalarioNeto).ToString("N2")
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (@lista.Any().ToString().ToLower()) {
                var config = Object.assign({}, DataTableConfig, {
                    order:      [[0, 'asc']],
                    scrollX:    true,
                    autoWidth:  false
                });
                $('#tablaDetalle').DataTable(config);
            }
        });
    </script>
}