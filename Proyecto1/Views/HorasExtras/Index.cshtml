@model List<HoraExtraAdminVM>


<h3 class="fw-bold mb-4">Gestión de Horas Extras</h3>

<form method="get" asp-action="Index" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="number"
               name="idColaborador"
               class="form-control"
               placeholder="Buscar por ID de colaborador" />
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">
            Buscar
        </button>
    </div>

    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-secondary w-100">
            Limpiar
        </a>
    </div>
</form>


<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID Colaborador</th>
            <th>Colaborador</th>
            <th>Fecha</th>
            <th>Horas</th>
            <th>Motivo</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Model)
        {
            <tr>
                <td>@h.IdColaborador</td>
                <td>@h.NombreColaborador</td>
                <td>@h.Fecha.ToShortDateString()</td>
                <td>@h.CantidadHoras</td>
                <td>@h.Motivo</td>
                <td>@h.Estado</td>
                <td>
                    @if (h.Estado == "Pendiente")
                    {
                        <form asp-action="CambiarEstado" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@h.IdHoraExtra" />
                            <input type="hidden" name="estado" value="Aprobada" />
                            <button type="submit" class="btn btn-success btn-sm">
                                Aprobar
                            </button>
                        </form>

                        <form asp-action="CambiarEstado" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@h.IdHoraExtra" />
                            <input type="hidden" name="estado" value="Rechazada" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                Rechazar
                            </button>
                        </form>
                    }

                </td>
            </tr>
        }
    </tbody>
</table>
