@model List<HoraExtraAdminVM>

@{
    ViewData["Title"] = "Gestión de Horas Extras";
    var idColActual = Context.Request.Query["idColaborador"].ToString();

    var pendientes = Model?.Count(h => h.Estado == "Pendiente") ?? 0;
    var aprobadas = Model?.Count(h => h.Estado == "Aprobada") ?? 0;
    var rechazadas = Model?.Count(h => h.Estado == "Rechazada") ?? 0;
    var totalHoras = Model?.Sum(h => h.CantidadHoras) ?? 0;
}

@* ================================================
   HEADER
   ================================================ *@
<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-alarm"></i>Gestión de Horas Extras
    </h3>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-house"></i>Inicio
    </a>
</div>

@* ================================================
   KPI CARDS
   ================================================ *@
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total solicitudes</div>
                <div class="kpi-value">@(Model?.Count ?? 0)</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-list-check"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Pendientes</div>
                <div class="kpi-value" style="color:var(--amber)">@pendientes</div>
            </div>
            <div class="kpi-icon amber">
                <i class="bi bi-clock-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Aprobadas</div>
                <div class="kpi-value" style="color:var(--green)">@aprobadas</div>
            </div>
            <div class="kpi-icon green">
                <i class="bi bi-check-circle-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total horas aprobadas</div>
                <div class="kpi-value">@totalHoras</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-clock-history"></i>
            </div>
        </div>
    </div>

</div>

@* ================================================
   FILTROS
   ================================================ *@
<div class="filter-card mb-4">
    <form method="get" asp-action="Index">
        <div class="filter-row">

            <div class="filter-group" style="max-width:200px;">
                <span class="filter-label">ID Colaborador</span>
                <input type="number"
                       name="idColaborador"
                       class="form-control"
                       placeholder="Ingrese ID..."
                       value="@idColActual" />
            </div>

            <div class="filter-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i>Buscar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i>Limpiar
                </a>
            </div>

        </div>
    </form>
</div>

@* ================================================
   TABLA
   ================================================ *@
<div class="card">
    <div class="card-header">
        <span class="card-header-title">
            <i class="bi bi-table"></i>Solicitudes de horas extras
        </span>
        <span class="badge badge-info">@(Model?.Count ?? 0) registros</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaHorasExtras" class="tabla-sistema w-100">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Colaborador</th>
                        <th class="text-center">Fecha</th>
                        <th class="text-center">Horas</th>
                        <th>Motivo</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var h in Model)
                        {
                            var iniciales = h.NombreColaborador?
                            .Split(' ')
                            .Where(s => !string.IsNullOrEmpty(s))
                            .Take(2)
                            .Select(s => s[0].ToString())
                            .Aggregate("", (acc, c) => acc + c)
                            .ToUpper() ?? "??";

                            string badgeClass = h.Estado switch
                            {
                                "Aprobada" => "bg-success",
                                "Pendiente" => "bg-warning",
                                _ => "bg-danger"
                            };

                            string avatarColor = h.Estado switch
                            {
                                "Aprobada" => "green",
                                "Pendiente" => "amber",
                                _ => "red"
                            };

                            <tr>
                                <td class="td-mono">@h.IdColaborador</td>
                                <td>
                                    <div class="table-avatar">
                                        <div class="avatar-circle avatar-@avatarColor">
                                            @iniciales
                                        </div>
                                        <div class="avatar-name">@h.NombreColaborador</div>
                                    </div>
                                </td>
                                <td class="text-center td-muted">
                                    @h.Fecha.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center">
                                    <span class="td-mono"
                                          style="font-weight:700;color:var(--blue)">
                                        @h.CantidadHoras h
                                    </span>
                                </td>
                                <td class="td-muted" style="max-width:200px;">
                                    @(h.Motivo?.Length > 50
                                                                ? h.Motivo.Substring(0, 50) + "..."
                                                                : h.Motivo)
                        </td>
                        <td class="text-center">
                            <span class="badge @badgeClass badge-dot">@h.Estado</span>
                        </td>
                        <td>
                            <div class="td-actions">
                                @if (h.Estado == "Pendiente")
                                        {
                                            <form asp-action="CambiarEstado"
                                                  method="post"
                                                  id="formAprobar_@h.IdHoraExtra"
                                                  class="d-inline">
                                                <input type="hidden" name="id" value="@h.IdHoraExtra" />
                                                <input type="hidden" name="estado" value="Aprobada" />
                                                <button type="button"
                                                        class="btn btn-success btn-sm"
                                                        onclick="confirmarCambio(@h.IdHoraExtra, 'aprobar', '@h.NombreColaborador')">
                                                    <i class="bi bi-check-circle"></i>Aprobar
                                                </button>
                                            </form>

                                            <form asp-action="CambiarEstado"
                                                  method="post"
                                                  id="formRechazar_@h.IdHoraExtra"
                                                  class="d-inline">
                                                <input type="hidden" name="id" value="@h.IdHoraExtra" />
                                                <input type="hidden" name="estado" value="Rechazada" />
                                                <button type="button"
                                                        class="btn btn-danger btn-sm"
                                                        onclick="confirmarCambio(@h.IdHoraExtra, 'rechazar', '@h.NombreColaborador')">
                                                    <i class="bi bi-x-circle"></i>Rechazar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="td-muted" style="font-size:0.82rem;">
                                                Sin acciones
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="table-empty">
                                    <i class="bi bi-alarm"></i>
                                    <p>No hay solicitudes de horas extras registradas</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        $(document).ready(function () {
            if (@((Model != null && Model.Any()).ToString().ToLower())) {
                var config = Object.assign({}, DataTableConfig, {
                    order: [[2, 'desc']]
                });
                $('#tablaHorasExtras').DataTable(config);
            }
        });

        function confirmarCambio(id, accion, nombre) {
            var mensaje = accion === 'aprobar'
                ? 'Se aprobará la solicitud de horas extras de ' + nombre + '. ¿Desea continuar?'
                : 'Se rechazará la solicitud de horas extras de ' + nombre + '. ¿Desea continuar?';

            var tipo = accion === 'aprobar' ? 'question' : 'warning';
            var formId = accion === 'aprobar'
                ? 'formAprobar_' + id
                : 'formRechazar_' + id;

            Alert.confirm(mensaje, function () {
                document.getElementById(formId).submit();
            }, tipo);
        }

    </script>
}