@model List<Proyecto1.Models.HoraExtra>

<h3 class="fw-bold mb-4">Consulta de Horas Extras</h3>

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>Colaborador</th>
            <th>Fecha</th>
            <th>Horas</th>
            <th>Motivo</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Model)
        {
            <tr>
                <td>@h.NombreColaborador</td>
                <td>@h.Fecha.ToShortDateString()</td>
                <td>@h.CantidadHoras</td>
                <td>@h.Motivo</td>
                <td>@h.Estado</td>
            </tr>
        }
    </tbody>
</table>

