@model List<Proyecto1.Models.HoraExtra>

@{
    ViewData["Title"] = "Mis Horas Extras";

    var pendientes = Model?.Count(h => h.Estado == "Pendiente") ?? 0;
    var aprobadas = Model?.Count(h => h.Estado == "Aprobada") ?? 0;
    var rechazadas = Model?.Count(h => h.Estado == "Rechazada") ?? 0;
    var totalHoras = Model?.Where(h => h.Estado == "Aprobada")
                          .Sum(h => h.CantidadHoras) ?? 0;
}

@* ================================================
   HEADER
   ================================================ *@
<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-clock-history"></i>Mis Horas Extras
    </h3>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-house"></i>Inicio
    </a>
</div>

@* ================================================
   KPI CARDS
   ================================================ *@
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Total solicitudes</div>
                <div class="kpi-value">@(Model?.Count ?? 0)</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-list-check"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Pendientes</div>
                <div class="kpi-value" style="color:var(--amber)">@pendientes</div>
            </div>
            <div class="kpi-icon amber">
                <i class="bi bi-clock-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Aprobadas</div>
                <div class="kpi-value" style="color:var(--green)">@aprobadas</div>
            </div>
            <div class="kpi-icon green">
                <i class="bi bi-check-circle-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="kpi-card">
            <div>
                <div class="kpi-label">Horas aprobadas</div>
                <div class="kpi-value" style="color:var(--blue)">@totalHoras</div>
            </div>
            <div class="kpi-icon blue">
                <i class="bi bi-alarm"></i>
            </div>
        </div>
    </div>

</div>

@* ================================================
   BOTÓN NUEVA SOLICITUD
   ================================================ *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted" style="font-size:0.82rem;">
        @(Model?.Count ?? 0) solicitud(es) registrada(s)
    </span>
    <a asp-controller="HorasExtras"
       asp-action="Create"
       class="btn btn-success">
        <i class="bi bi-plus-circle"></i>Nueva solicitud
    </a>
</div>

@* ================================================
   TABLA
   ================================================ *@
<div class="card">
    <div class="card-header">
        <span class="card-header-title">
            <i class="bi bi-table"></i>Historial de solicitudes
        </span>
        <div class="d-flex align-items-center gap-3">
            <select id="filtroEstado"
                    class="form-select form-select-sm"
                    style="width:140px;">
                <option value="">Todos</option>
                <option value="Pendiente">Pendientes</option>
                <option value="Aprobada">Aprobadas</option>
                <option value="Rechazada">Rechazadas</option>
            </select>
            <span class="badge badge-info" id="badgeContador">
                @(Model?.Count ?? 0) registros
            </span>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaMisHoras" class="tabla-sistema w-100">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th class="text-center">Horas</th>
                        <th>Motivo</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var h in Model.OrderByDescending(h => h.Fecha))
                        {
                            string badgeClass = h.Estado switch
                            {
                                "Aprobada" => "bg-success",
                                "Pendiente" => "bg-warning",
                                _ => "bg-danger"
                            };

                            var esPendiente = h.Estado == "Pendiente";

                            <tr data-estado="@h.Estado"
                                class="@(esPendiente ? "fila-pendiente" : "")">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (esPendiente)
                                        {
                                            <span class="badge bg-warning"
                                                  style="font-size:0.65rem;">PENDIENTE</span>
                                        }
                                <span class="td-mono">
                                    @h.Fecha.ToString("dd/MM/yyyy")
                                </span>
                            </div>
                        </td>
                        <td class="text-center">
                            <span class="td-mono"
                                  style="font-weight:700;color:var(--blue);">
                                @h.CantidadHoras h
                            </span>
                        </td>
                        <td class="td-muted">
                            @(string.IsNullOrEmpty(h.Motivo)
                                                        ? "Sin motivo registrado"
                                                        : h.Motivo.Length > 80
                                                        ? h.Motivo.Substring(0, 80) + "..."
                                                        : h.Motivo)
                        </td>
                        <td class="text-center">
                            <span class="badge @badgeClass badge-dot">
                                @h.Estado
                            </span>
                        </td>
                    </tr>
                                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="table-empty">
                                    <i class="bi bi-clock-history"></i>
                                    <p>No tienes solicitudes de horas extras registradas</p>
                                    <a asp-controller="HorasExtras"
                                       asp-action="Create"
                                       class="btn btn-success btn-sm">
                                        <i class="bi bi-plus-circle"></i>Nueva solicitud
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .fila-pendiente {
            background: #fffbeb !important;
        }

            .fila-pendiente:hover {
                background: #fef3c7 !important;
            }
    </style>
}

@section Scripts {
    <script>

        $(document).ready(function () {
            if (@((Model != null && Model.Any()).ToString().ToLower())) {
                var config = Object.assign({}, DataTableConfig, {
                    order: [[0, 'desc']]
                });
                $('#tablaMisHoras').DataTable(config);
            }
        });

        var filtroEstado  = document.getElementById('filtroEstado');
        var badgeContador = document.getElementById('badgeContador');

        filtroEstado.addEventListener('change', function () {
            var estado = this.value;
            var table  = $('#tablaMisHoras').DataTable();

            table.rows().every(function () {
                var fila       = this.node();
                var filaEstado = fila.getAttribute('data-estado');
                var ok         = estado === '' || filaEstado === estado;
                $(fila).toggle(ok);
            });

            var visibles = $('#tablaMisHoras tbody tr:visible').length;
            badgeContador.textContent = visibles + ' registros';
        });

    </script>
}