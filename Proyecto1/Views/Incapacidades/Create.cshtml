@model Proyecto1.Models.Incapacidad
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Registrar Incapacidad";
}

@* ================================================
   HEADER
   ================================================ *@
<div class="page-header">
    <h3 class="page-title">
        <i class="bi bi-heart-pulse"></i>Registrar Incapacidad
    </h3>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>Volver
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-10">

        <form asp-action="Create" method="post" id="formIncapacidad" enctype="multipart/form-data" novalidate>

            @Html.AntiForgeryToken()

            @* ================================================
               PASO 1 — Buscar colaborador
               ================================================ *@
            <div class="card mb-4">
                <div class="card-header">
                    <span class="card-header-title">
                        <i class="bi bi-search"></i>Paso 1 — Colaborador
                    </span>
                </div>
                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-5">
                            <label class="form-label">
                                ID Colaborador <span class="required">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="IdColaborador"
                                       class="form-control"
                                       placeholder="Ej: 12"
                                       type="number"
                                       min="1" />
                                <button type="submit"
                                        name="accion"
                                        value="buscar"
                                        class="btn btn-primary">
                                    <i class="bi bi-search"></i>Buscar
                                </button>
                            </div>
                            <span asp-validation-for="IdColaborador"
                                  class="form-error d-block"></span>
                        </div>

                        <div class="col-md-7">
                            <label class="form-label">Nombre del colaborador</label>
                            <input class="form-control"
                                   value="@(ViewBag.NombreColaborador ?? "Se carga al buscar...")"
                                   readonly
                                   style="background:var(--slate-ll);" />
                        </div>

                    </div>

                    @if (ViewBag.NombreColaborador != null)
                    {
                        <div class="colaborador-found mt-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-circle avatar-red"
                                     style="width:40px;height:40px;font-size:0.9rem;flex-shrink:0;">
                                    @{
                                        var nombre = (string)ViewBag.NombreColaborador;
                                        var inics = string.Join("",
                                        nombre.Split(' ')
                                        .Where(s => !string.IsNullOrEmpty(s))
                                        .Take(2)
                                        .Select(s => s[0].ToString()))
                                        .ToUpper();
                                    }
                                    @inics
                                </div>
                                <div style="font-weight:600;font-size:0.9rem;color:var(--text);">
                                    @ViewBag.NombreColaborador
                                </div>
                                <span class="badge bg-success badge-dot ms-auto">
                                    Encontrado
                                </span>
                            </div>
                        </div>
                    }

                </div>
            </div>

            @* ================================================
               PASO 2 — Datos de la incapacidad
               ================================================ *@
            <div class="card mb-4">
                <div class="card-header">
                    <span class="card-header-title">
                        <i class="bi bi-heart-pulse"></i>Paso 2 — Datos de la incapacidad
                    </span>
                </div>
                <div class="card-body">

                    @* Tipo *@
                    <div class="mb-3">
                        <label class="form-label">
                            Tipo de incapacidad <span class="required">*</span>
                        </label>
                        <select asp-for="IdTipoIncapacidad"
                                class="form-select"
                                asp-items="@(new SelectList(ViewBag.TiposIncapacidad,
                                                                                                                                                                                            "IdTipoIncapacidad",
                                                                                                                                                                                            "Nombre"))">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="IdTipoIncapacidad"
                              class="form-error d-block"></span>
                    </div>

                    @* Fechas *@
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">
                                Fecha inicio <span class="required">*</span>
                            </label>
                            <input asp-for="FechaInicio"
                                   type="date"
                                   class="form-control"
                                   id="inputFechaInicio" />
                            <span asp-validation-for="FechaInicio"
                                  class="form-error d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Fecha fin <span class="required">*</span>
                            </label>
                            <input asp-for="FechaFin"
                                   type="date"
                                   class="form-control"
                                   id="inputFechaFin" />
                            <span id="msgFechas" class="form-text"
                                  style="display:none;"></span>
                            <span asp-validation-for="FechaFin"
                                  class="form-error d-block"></span>
                        </div>
                    </div>

                    @* Días calculados *@
                    <div class="mb-3">
                        <div class="detail-field">
                            <span class="detail-label">
                                <i class="bi bi-calendar-range"></i>Días de incapacidad
                            </span>
                            <span id="diasCalculados"
                                  style="font-size:1.1rem;font-weight:700;
                                         color:var(--amber);font-family:'Consolas',monospace;">
                                —
                            </span>
                        </div>
                    </div>

                    @* Motivo *@
                    <div class="mb-4">
                        <label class="form-label">Motivo</label>
                        <textarea asp-for="Motivo"
                                  id="inputMotivo"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Describa el motivo de la incapacidad..."
                                  style="resize:vertical;"></textarea>
                        <div class="d-flex justify-content-end mt-1">
                            <span id="contadorMotivo" class="form-text">0 / 300</span>
                        </div>
                    </div>

                    @* ================================================
                       ADJUNTAR ARCHIVO
                       ================================================ *@
                    <div class="mb-0">
                        <label class="form-label">
                            <i class="bi bi-paperclip"></i>Adjuntar documento (Certificado médico)
                        </label>
                        <div class="upload-area" id="uploadArea">
                            <input type="file"
                                   id="inputArchivo"
                                   name="ArchivoAdjunto"
                                   class="d-none"
                                   accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                            <div class="upload-content">
                                <i class="bi bi-cloud-arrow-up"></i>
                                <p style="margin: 8px 0 0 0; font-weight: 500;">Arrastra tu archivo aquí</p>
                                <p style="margin: 2px 0 0 0; color: var(--text-3); font-size: 0.85rem;">
                                    o <a href="#" id="linkSeleccionar" style="color: var(--blue); text-decoration: none; font-weight: 500;">selecciona uno</a>
                                </p>
                                <p style="margin: 8px 0 0 0; color: var(--text-3); font-size: 0.75rem;">
                                    Formatos permitidos: PDF, DOC, DOCX, JPG, PNG (máx. 5 MB)
                                </p>
                            </div>
                        </div>
                        <div id="archivoSeleccionado" style="display: none; margin-top: 12px;">
                            <div class="alert alert-success d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-check-circle-fill"></i>
                                <span id="nombreArchivo"></span>
                                <button type="button"
                                        class="btn btn-link btn-sm ms-auto p-0"
                                        onclick="limpiarArchivo(); return false;">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <hr class="section-divider" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i>Cancelar
                </a>
                <button type="submit"
                        name="accion"
                        value="guardar"
                        id="btnGuardar"
                        class="btn btn-success">
                    <i class="bi bi-check-circle"></i>Guardar incapacidad
                </button>
            </div>

        </form>
    </div>
</div>

@section Styles {
    <style>
        .required {
            color: var(--red);
            margin-left: 2px;
        }

        .colaborador-found {
            background: var(--green-l);
            border: 1px solid #bbf7d0;
            border-radius: var(--radius);
            padding: 12px 16px;
        }

        .detail-field {
            display: flex;
            flex-direction: column;
            gap: 5px;
            padding: 12px 14px;
            background: var(--slate-ll);
            border-radius: var(--radius);
            border: 1px solid var(--border);
        }

        .detail-label {
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-3);
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .detail-label i {
                font-size: 0.75rem;
            }

        .field-validation-error {
            color: var(--red);
            font-size: 0.78rem;
            margin-top: 4px;
        }

        .input-validation-error {
            border-color: var(--red) !important;
        }

        /* ========== UPLOAD AREA ========== */
        .upload-area {
            border: 2px dashed var(--border-d);
            border-radius: var(--radius-lg);
            padding: 32px 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: var(--slate-ll);
        }

            .upload-area:hover {
                border-color: var(--blue);
                background: #f0f8ff;
            }

            .upload-area.dragover {
                border-color: var(--blue);
                background: #e0f2fe;
            }

        .upload-content i {
            font-size: 2.5rem;
            color: var(--blue);
            display: block;
            margin-bottom: 8px;
        }

        .alert-success {
            background: var(--green-l) !important;
            border: 1px solid #86efac !important;
            color: var(--green-t) !important;
        }

            .alert-success i {
                color: var(--green);
            }
    </style>
}

@section Scripts {
    <script>

        var inputInicio  = document.getElementById('inputFechaInicio');
        var inputFin     = document.getElementById('inputFechaFin');
        var diasSpan     = document.getElementById('diasCalculados');
        var msgFechas    = document.getElementById('msgFechas');
        var motivo       = document.getElementById('inputMotivo');
        var contador     = document.getElementById('contadorMotivo');
        var uploadArea   = document.getElementById('uploadArea');
        var inputArchivo = document.getElementById('inputArchivo');
        var linkSeleccionar = document.getElementById('linkSeleccionar');

                // ========== UPLOAD ARCHIVO ==========
        uploadArea.addEventListener('click', function (e) {
            e.stopPropagation();
            inputArchivo.click();
        });

        linkSeleccionar.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            inputArchivo.click();
        });

        // Drag and drop
        uploadArea.addEventListener('dragover', function (e) {
            e.preventDefault();
            e.stopPropagation();
            uploadArea.classList.add('dragover');
        });

        uploadArea.addEventListener('dragleave', function (e) {
            e.preventDefault();
            e.stopPropagation();
            uploadArea.classList.remove('dragover');
        });

        uploadArea.addEventListener('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            uploadArea.classList.remove('dragover');
            var files = e.dataTransfer.files;
            if (files.length > 0) {
                inputArchivo.files = files;
                mostrarArchivoSeleccionado(files[0]);
            }
        });

        // ✅ Seleccionar archivo - SOLUCIÓN DEFINITIVA
        inputArchivo.addEventListener('change', function (e) {
            e.stopPropagation();

            if (this.files.length > 0) {
                mostrarArchivoSeleccionado(this.files[0]);
                // Limpiar el input para que no se dispare change nuevamente
                this.value = '';
            }
        }, {once: false});

        function mostrarArchivoSeleccionado(file) {
            // Validar tamaño
            var maxSize = 5 * 1024 * 1024; // 5 MB
            if (file.size > maxSize) {
                Alert.error('El archivo no debe superar 5 MB');
                inputArchivo.value = '';
                return;
            }

            uploadArea.style.display = 'none';
            document.getElementById('archivoSeleccionado').style.display = 'block';
            document.getElementById('nombreArchivo').textContent = file.name + ' (' + (file.size / 1024).toFixed(2) + ' KB)';
        }

        function limpiarArchivo() {
            inputArchivo.value = '';
            uploadArea.style.display = 'block';
            document.getElementById('archivoSeleccionado').style.display = 'none';
        }

        // Calcular días entre fechas
        function calcularDias() {
            var inicio = inputInicio.value;
            var fin    = inputFin.value;

            if (!inicio || !fin) {
                diasSpan.textContent = '—';
                msgFechas.style.display = 'none';
                return;
            }

            var d1   = new Date(inicio);
            var d2   = new Date(fin);
            var diff = Math.round((d2 - d1) / (1000 * 60 * 60 * 24)) + 1;

            if (diff <= 0) {
                diasSpan.textContent    = '—';
                msgFechas.style.display = 'block';
                msgFechas.style.color   = 'var(--red)';
                msgFechas.textContent   = 'La fecha fin debe ser posterior a la fecha inicio';
                inputFin.style.borderColor = 'var(--red)';
            } else {
                diasSpan.textContent    = diff + ' día(s)';
                msgFechas.style.display = 'block';
                msgFechas.style.color   = 'var(--green)';
                msgFechas.textContent   = diff + ' día(s) de incapacidad';
                inputFin.style.borderColor = 'var(--green)';
            }
        }

        inputInicio.addEventListener('change', calcularDias);
        inputFin.addEventListener('change', calcularDias);

        // Inicializar si ya hay fechas cargadas
        calcularDias();

        // Contador motivo
        if (motivo) {
            motivo.addEventListener('input', function () {
                var len = motivo.value.length;
                contador.textContent = len + ' / 300';
                contador.style.color = len > 300 ? 'var(--red)' : 'var(--text-3)';
                if (len > 300) motivo.value = motivo.value.substring(0, 300);
            });
        }

    </script>
}