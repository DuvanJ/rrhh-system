@model List<Proyecto1.Models.IncapacidadAdminVM>

@{
    ViewData["Title"] = "Gestión de Incapacidades";
}

<h2 class="mb-3">Gestión de Incapacidades</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">Gestión de Incapacidades</h3>

    <a asp-action="Create"
       class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i>
        Registrar Incapacidad
    </a>
</div>


<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="number"
               name="idColaborador"
               class="form-control"
               placeholder="ID Colaborador" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">
            Buscar
        </button>
    </div>
</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">@TempData["Warning"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Colaborador</th>
            <th>Tipo</th>
            <th>Inicio</th>
            <th>Fin</th>
            <th>Días</th>
            <th>Remunerada</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>@i.IdIncapacidad</td>
                <td>@i.NombreColaborador</td>
                <td>@i.TipoIncapacidad</td>
                <td>@i.FechaInicio.ToString("dd/MM/yyyy")</td>
                <td>@i.FechaFin.ToString("dd/MM/yyyy")</td>
                <td>@i.DiasIncapacidad</td>
                <td>@(i.EsRemunerada ? "Sí" : "No")</td>
                <td>@i.Estado</td>
                <td>
                    @if (i.Estado == "Activa")
                    {
                        <form asp-action="CambiarEstado"
                              method="post"
                              class="d-inline">
                            <input type="hidden" name="id" value="@i.IdIncapacidad" />
                            <input type="hidden" name="estado" value="Cerrada" />
                            <button class="btn btn-sm btn-danger">
                                Cerrar
                            </button>
                        </form>
                    }

                    <a asp-action="Detalle"
                       asp-route-id="@i.IdIncapacidad"
                       class="btn btn-sm btn-info">
                        Detalle
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
